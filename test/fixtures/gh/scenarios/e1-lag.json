{
  "routes": [
    {
      "when": { "subcommand": "graphql" },
      "file": "e1-lag-graphql.json"
    },
    {
      "when": { "containsAll": ["pulls/7/comments"] },
      "pages": [
        [
          { "id": 300, "node_id": "PRRC_300", "user": { "login": "reviewer" }, "body": "known thread root", "created_at": "2026-09-14T10:00:00Z" },
          { "id": 301, "node_id": "PRRC_301", "user": { "login": "pr-author" }, "body": "fresh responder reply on the KNOWN thread", "created_at": "2026-09-15T09:00:00Z", "in_reply_to_id": 300 },
          { "id": 400, "node_id": "PRRC_400", "user": { "login": "late-reviewer" }, "body": "fresh thread root: only REST knows me", "created_at": "2026-09-15T10:00:00Z" },
          { "id": 401, "node_id": "PRRC_401", "user": { "login": "pr-author" }, "body": "fresh reply on the fresh thread", "created_at": "2026-09-15T10:30:00Z", "in_reply_to_id": 400 }
        ]
      ]
    },
    {
      "when": { "containsAll": ["issues/7/comments"] },
      "pages": [
        [
          { "id": 900, "node_id": "IC_900", "user": { "login": "bystander" }, "body": "general PR conversation", "created_at": "2026-09-14T09:00:00Z" }
        ]
      ]
    }
  ]
}
