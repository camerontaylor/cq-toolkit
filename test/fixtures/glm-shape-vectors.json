{
  "//": "Shared cross-language GLM-5.3-flash capability shape vectors. Consumed by BOTH the TS test (test/driver/glm-capability.test.ts) and the Python test (tests/test_glm_capability.py). NO hard-coded byte counts are stored here: each language computes the rendered bound independently and must agree; the stored expectations are STRUCTURAL (exact literal inclusions, refusal cases, monotonicity). This avoids fabricating a numeric proof that was never executed.",
  "profile": {
    "provider": "zai",
    "model": "glm-5.3-flash",
    "endpoint": "https://api.z.ai/api/coding/paas/v4"
  },
  "accept": [
    {
      "name": "minimal user turn",
      "projection": {
        "prompt": [{ "role": "user", "content": [{ "type": "text", "text": "hello" }] }],
        "tools": null,
        "toolChoice": null,
        "responseFormat": null,
        "providerOptions": null,
        "maxOutputTokens": 64,
        "temperature": null,
        "topP": null,
        "topK": null,
        "presencePenalty": null,
        "frequencyPenalty": null,
        "stopSequences": null,
        "seed": null,
        "reasoning": null
      },
      "mustContain": [
        "[gMASK]<sop>",
        "<|system|>Reasoning Effort: Max",
        "<|user|>hello",
        "<|assistant|><think>"
      ],
      "mustNotContain": ["<|observation|>", "# Tools"]
    },
    {
      "name": "system + user, reasoning effort low",
      "projection": {
        "prompt": [
          { "role": "system", "content": "sys" },
          { "role": "user", "content": [{ "type": "text", "text": "q" }] }
        ],
        "tools": null,
        "toolChoice": null,
        "responseFormat": null,
        "providerOptions": { "zai": { "reasoningEffort": "low" } },
        "maxOutputTokens": 64,
        "temperature": null,
        "topP": null,
        "topK": null,
        "presencePenalty": null,
        "frequencyPenalty": null,
        "stopSequences": null,
        "seed": null,
        "reasoning": null
      },
      "mustContain": ["Reasoning Effort: Low", "<|system|>sys", "<|user|>q"],
      "mustNotContain": ["Reasoning Effort: Max"]
    },
    {
      "name": "local function tool surface",
      "projection": {
        "prompt": [{ "role": "user", "content": [{ "type": "text", "text": "q" }] }],
        "tools": [
          {
            "type": "function",
            "name": "read",
            "description": "read a file",
            "inputSchema": { "type": "object", "properties": { "path": { "type": "string" } } }
          }
        ],
        "toolChoice": "auto",
        "responseFormat": null,
        "providerOptions": null,
        "maxOutputTokens": 64,
        "temperature": null,
        "topP": null,
        "topK": null,
        "presencePenalty": null,
        "frequencyPenalty": null,
        "stopSequences": null,
        "seed": null,
        "reasoning": null
      },
      "mustContain": [
        "# Tools",
        "<tools>",
        "\"name\": \"read\"",
        "</tools>",
        "<tool_call>{function-name}"
      ],
      "mustNotContain": []
    },
    {
      "name": "assistant tool-call + observation block",
      "projection": {
        "prompt": [
          { "role": "user", "content": [{ "type": "text", "text": "q" }] },
          {
            "role": "assistant",
            "content": [
              { "type": "reasoning", "text": "thinking" },
              { "type": "text", "text": "calling read" },
              {
                "type": "tool-call",
                "toolCallId": "t1",
                "toolName": "read",
                "input": { "path": "a.txt" }
              }
            ]
          },
          {
            "role": "tool",
            "content": [
              {
                "type": "tool-result",
                "toolCallId": "t1",
                "output": { "type": "text", "value": "file-body" }
              }
            ]
          }
        ],
        "tools": null,
        "toolChoice": null,
        "responseFormat": null,
        "providerOptions": null,
        "maxOutputTokens": 64,
        "temperature": null,
        "topP": null,
        "topK": null,
        "presencePenalty": null,
        "frequencyPenalty": null,
        "stopSequences": null,
        "seed": null,
        "reasoning": null
      },
      "mustContain": [
        "<think>thinking</think>",
        "calling read",
        "<tool_call>read",
        "<arg_key>path</arg_key><arg_value>a.txt</arg_value>",
        "<|observation|>",
        "<tool_response>file-body</tool_response>"
      ],
      "mustNotContain": []
    },
    {
      "name": "astral + escaped HTML + JSON-string tool argument",
      "projection": {
        "prompt": [
          {
            "role": "user",
            "content": [{ "type": "text", "text": "emoji 😀 and <b>bold</b> & \"quote\"" }]
          }
        ],
        "tools": null,
        "toolChoice": null,
        "responseFormat": null,
        "providerOptions": null,
        "maxOutputTokens": 64,
        "temperature": null,
        "topP": null,
        "topK": null,
        "presencePenalty": null,
        "frequencyPenalty": null,
        "stopSequences": null,
        "seed": null,
        "reasoning": null
      },
      "mustContain": ["😀", "<b>bold</b>", "& \"quote\""],
      "mustNotContain": []
    },
    {
      "name": "tool description with HTML/quote chars is Jinja-JSON escaped (never shorter)",
      "projection": {
        "prompt": [{ "role": "user", "content": [{ "type": "text", "text": "q" }] }],
        "tools": [
          {
            "type": "function",
            "name": "read",
            "description": "<script> & 'quoted' >",
            "inputSchema": { "type": "object", "properties": { "a": { "type": "string" } } }
          }
        ],
        "toolChoice": null,
        "responseFormat": null,
        "providerOptions": null,
        "maxOutputTokens": 64,
        "temperature": null,
        "topP": null,
        "topK": null,
        "presencePenalty": null,
        "frequencyPenalty": null,
        "stopSequences": null,
        "seed": null,
        "reasoning": null
      },
      "mustContain": ["\\u003c", "\\u0026", "\\u0027", "\\u003e"],
      "mustNotContain": ["<script>"]
    },
    {
      "name": "clear_thinking clears a historical assistant think block",
      "projection": {
        "prompt": [
          {
            "role": "assistant",
            "content": [
              { "type": "reasoning", "text": "OLD-THOUGHT" },
              { "type": "text", "text": "a" }
            ]
          },
          { "role": "user", "content": [{ "type": "text", "text": "u" }] }
        ],
        "tools": null,
        "toolChoice": null,
        "responseFormat": null,
        "providerOptions": { "zai": { "thinking": { "clearThinking": true } } },
        "maxOutputTokens": 64,
        "temperature": null,
        "topP": null,
        "topK": null,
        "presencePenalty": null,
        "frequencyPenalty": null,
        "stopSequences": null,
        "seed": null,
        "reasoning": null
      },
      "mustContain": ["<think></think>"],
      "mustNotContain": ["<think>OLD-THOUGHT</think>"]
    },
    {
      "name": "tool schema with safe integers renders exactly",
      "projection": {
        "prompt": [{ "role": "user", "content": [{ "type": "text", "text": "q" }] }],
        "tools": [
          {
            "type": "function",
            "name": "read",
            "description": "read",
            "inputSchema": {
              "type": "object",
              "properties": { "n": { "type": "string", "maxLength": 10 } }
            }
          }
        ],
        "toolChoice": null,
        "responseFormat": null,
        "providerOptions": null,
        "maxOutputTokens": 64,
        "temperature": null,
        "topP": null,
        "topK": null,
        "presencePenalty": null,
        "frequencyPenalty": null,
        "stopSequences": null,
        "seed": null,
        "reasoning": null
      },
      "mustContain": ["\"maxLength\": 10"],
      "mustNotContain": []
    }
  ],
  "refuse": [
    {
      "name": "image part",
      "projection": {
        "prompt": [{ "role": "user", "content": [{ "type": "image", "image": "x" }] }],
        "tools": null,
        "toolChoice": null,
        "responseFormat": null,
        "providerOptions": null,
        "maxOutputTokens": 64
      }
    },
    {
      "name": "hosted/provider tool",
      "projection": {
        "prompt": [{ "role": "user", "content": [{ "type": "text", "text": "q" }] }],
        "tools": [{ "type": "provider", "id": "web_search" }],
        "toolChoice": null,
        "responseFormat": null,
        "providerOptions": null,
        "maxOutputTokens": 64
      }
    },
    {
      "name": "unknown provider option",
      "projection": {
        "prompt": [{ "role": "user", "content": [{ "type": "text", "text": "q" }] }],
        "tools": null,
        "toolChoice": null,
        "responseFormat": null,
        "providerOptions": { "zai": { "max_tokens": 10 } },
        "maxOutputTokens": 64
      }
    },
    {
      "name": "thinking disabled",
      "projection": {
        "prompt": [{ "role": "user", "content": [{ "type": "text", "text": "q" }] }],
        "tools": null,
        "toolChoice": null,
        "responseFormat": null,
        "providerOptions": { "zai": { "thinking": { "type": "disabled" } } },
        "maxOutputTokens": 64
      }
    },
    {
      "name": "responseFormat present without hosted transform",
      "projection": {
        "prompt": [{ "role": "user", "content": [{ "type": "text", "text": "q" }] }],
        "tools": null,
        "toolChoice": null,
        "responseFormat": { "type": "json" },
        "providerOptions": null,
        "maxOutputTokens": 64
      }
    },
    {
      "name": "maxOutputTokens not a safe positive integer",
      "projection": {
        "prompt": [{ "role": "user", "content": [{ "type": "text", "text": "q" }] }],
        "tools": null,
        "toolChoice": null,
        "responseFormat": null,
        "providerOptions": null,
        "maxOutputTokens": 0
      }
    },
    {
      "name": "non-integral float in tool schema (JS/Python formatting differ)",
      "projection": {
        "prompt": [{ "role": "user", "content": [{ "type": "text", "text": "q" }] }],
        "tools": [
          { "type": "function", "name": "f", "inputSchema": { "type": "number", "minimum": 0.5 } }
        ],
        "toolChoice": null,
        "responseFormat": null,
        "providerOptions": null,
        "maxOutputTokens": 64
      }
    }
  ],
  "monotonic": [
    {
      "name": "longer user text strictly increases the bound",
      "smaller": {
        "prompt": [{ "role": "user", "content": [{ "type": "text", "text": "a" }] }],
        "tools": null,
        "toolChoice": null,
        "responseFormat": null,
        "providerOptions": null,
        "maxOutputTokens": 64
      },
      "larger": {
        "prompt": [
          {
            "role": "user",
            "content": [{ "type": "text", "text": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" }]
          }
        ],
        "tools": null,
        "toolChoice": null,
        "responseFormat": null,
        "providerOptions": null,
        "maxOutputTokens": 64
      }
    }
  ]
}
