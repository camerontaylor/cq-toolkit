{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/index.ts",
    "src/cli.ts",
    "src/registry/types.ts",
    "src/ops/*/registry.ts",
    "scripts/*.mjs",
    "scripts/ci-select-checks.d.mts",
    "scripts/lib/affected-tests.d.mts",
    "scripts/lib/build-env.d.mts",
    "scripts/lib/eval-axes-select.d.mts",
    "scripts/lib/dist-tests.d.mts",
    "scripts/lib/render-templates.d.mts",
    "scripts/lib/test-narrow.d.mts",
    "scripts/lib/related-tests.d.mts",
    "scripts/archive-measurement-evidence.d.mts",
    "scripts/archive-measurement-wrapper.d.mts",
    "scripts/measurement-session-index.d.mts",
    "scripts/measurement-inputs.d.mts",
    "scripts/measurement-metrics.d.mts",
    "scripts/measurement-outcomes.d.mts",
    "scripts/measurement-acceptance.d.mts",
    "scripts/measurement-rollup.d.mts",
    "test/fixtures/ratchet-lib-selfhost.mjs",
    "test/fixtures/cli-ops/fixture/*.js",
    "test/fixtures/cli-smoke-ops/smoke/*.js",
    "test/fixtures/cli-verdict-ops/verdict/*.js",
    "src/queue-runner/crq.ts"
  ],
  "project": [
    "src/**/*.ts",
    "test/**/*.{ts,js,mjs}",
    "lint/**/*.{ts,mjs}",
    "scripts/**/*.{mjs,mts}"
  ],
  "ignoreDependencies": ["@anthropic-ai/claude-agent-sdk"],
  "include": ["files", "dependencies", "unlisted", "unresolved"]
}
