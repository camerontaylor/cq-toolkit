{
  "name": "@camerontaylor/cq-toolkit",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "policy",
    "LICENSE",
    "README.md"
  ],
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "cq": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && mkdir -p dist/ops/merge/prompts && cp src/ops/merge/prompts/*.md dist/ops/merge/prompts/",
    "typecheck": "npm run check:static",
    "lint": "npm run check:static",
    "test": "vitest run",
    "denylist": "./scripts/denylist-scan",
    "format:check": "oxfmt --check .",
    "check:static": "node scripts/ratchet-typecheck.mjs",
    "lint:fast": "node scripts/lint-fast.mjs",
    "fix": "node scripts/fix.mjs",
    "check": "npm run format:check && npm run check:static && npm run test && npm run knip",
    "knip": "knip --no-progress"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.53",
    "@ai-sdk/deepseek": "3.0.44",
    "@ai-sdk/openai": "4.0.66",
    "@ai-sdk/zai": "3.0.10",
    "ai": "7.0.99",
    "p-limit": "7.3.2",
    "proper-lockfile": "4.1.2",
    "zod": "4.6.4"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.270"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/provider": "4.0.14",
    "@types/node": "24.13.5",
    "knip": "6.35.1",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2",
    "vitest": "5.0.0",
    "@vitest/coverage-v8": "5.0.0"
  }
}
