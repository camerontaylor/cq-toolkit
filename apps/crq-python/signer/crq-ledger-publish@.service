[Unit]
Description=CRQ root signer ledger publication

[Service]
User=root
Group=root
ExecStart=/usr/bin/python3 -I /opt/cq-reviewer/crq-signer.py ledger-publish
StandardInput=socket
StandardOutput=socket
StandardError=journal
Environment=PATH=/usr/bin:/bin
UMask=077
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
NoNewPrivileges=true
TimeoutStartSec=330
RuntimeMaxSec=330
