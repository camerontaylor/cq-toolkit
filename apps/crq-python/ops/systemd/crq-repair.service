[Unit]
Description=CRQ detached repair inbox drain
[Service]
Type=simple
Nice=10
Environment=PATH=%h/.local/share/mise/shims:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=%h/repos/coderabbit-queue
ExecStart=/usr/bin/env python3 %h/repos/coderabbit-queue/crq_repair.py
Restart=on-failure
RestartSec=60
