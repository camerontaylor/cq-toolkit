[Unit]
Description=CRQ model-free queue tick
[Service]
Type=oneshot
Nice=10
Environment=PATH=%h/.local/share/mise/shims:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=CODERABBIT_CLI_DISABLE_AUTO_UPDATE=true
Environment=CODERABBIT_CLI_UPDATE_MANAGED=true
WorkingDirectory=@CRQ_ROOT@
ExecStart=/usr/bin/env python3 @CRQ_ROOT@/crq.py tick
TimeoutStartSec=10min
KillMode=process
