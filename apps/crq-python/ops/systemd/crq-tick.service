[Unit]
Description=CRQ model-free queue tick
[Service]
Type=oneshot
Nice=10
Environment=PATH=%h/.local/share/mise/shims:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=%h/repos/coderabbit-queue
ExecStart=/usr/bin/env python3 %h/repos/coderabbit-queue/crq.py tick
TimeoutStartSec=10min
KillMode=process
