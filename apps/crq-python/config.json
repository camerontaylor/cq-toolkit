{
  "repo": "camerontaylor/cq-toolkit",
  "clone": "@HOST_CLONE@",
  "worktree_root": "@HOST_WORKTREE_ROOT@",
  "repos": [],
  "notify": {"hosts": []},
  "_repos_note": "Per-repo review config for non-primary repositories; empty keeps single-repo behavior. Shape and semantics: docs/multi-repo.md. Host overlays supply entries with real clone paths at deploy time.",
  "worktree_prefix": "coderabbit-queue-",
  "max_starts_per_hour": 5,
  "max_starts_per_tick": 10,
  "max_inflight": 10,
  "review_timeout_min": 120,
  "quiet_minutes": 30,
  "local_review_aging_minutes": 60,
  "rate_limit_default_backoff_min": 30,
  "error_backoff_min": 30,
  "max_item_failures": 3,
  "merged_discovery": {
    "enabled": true,
    "after": "2026-11-01T00:00:00Z"
  },
  "merged_min_survival": 0.25,
  "merged_min_surviving_lines": 15,
  "merged_min_file_focus": 0.25,
  "alerts": {
    "alert_agent_id": "00000000-0000-4000-8000-000000000004",
    "alert_agent_host": null,
    "_alert_agent_host_note": "Host overlay supplies the alert endpoint; ops/HOST-DEPLOY.md."
  },
  "stale_alarm_min": 36,
  "timeout_bin": "timeout",
  "paseo_hosts": [],
  "repair": {
    "enabled": true,
    "spend_authorization": "owner 2026-11-08: cq fixers and judges; Z.ai with OpenCode Go and DeepSeek fallback",
    "fallback_models": ["opencode-go/deepseek-v4.1-flash", "deepseek/deepseek-flash"],
    "max_rounds_per_pin": 2,
    "fix_pr_cycles": 1,
    "blackout": {
      "enabled": false,
      "tz": "Asia/Singapore",
      "days": [
        1,
        2,
        3,
        4,
        5
      ],
      "start": "14:00",
      "end": "18:00"
    },
    "budget": {
      "wall_clock_min": 20,
      "max_tokens": 400000,
      "max_output_tokens": 500000,
      "max_context_tokens": 200000
    },
    "mechanical": {
      "tests": false,
      "hack_detector": true
    },
    "judge_sample_rate": 0.0,
    "cq_bin": "@HOST_CQ_BIN@",
    "roles": {
      "fixer": {
        "driver": "cq",
        "model": "zai/glm-5.3-flash"
      },
      "fixer_escalation": {
        "driver": "cq",
        "model": "zai/glm-5.3"
      },
      "judge": {
        "driver": "cq",
        "model": "zai/glm-5.3-flash"
      },
      "judge_critical": {
        "driver": "cq",
        "model": "zai/glm-5.3"
      }
    },
    "paseo_host": null,
    "paseo_read_only_mode": null,
    "codex_budget_launcher": null,
    "codex_budget_launcher_verified": false,
    "paseo_budget_launcher": null,
    "paseo_budget_launcher_verified": false
  },
  "coverage": {
    "max_paths": 8,
    "min_age_hours": 24,
    "excluded_paths": []
  }
}
