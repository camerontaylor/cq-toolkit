{
  "repo": "camerontaylor/cq-toolkit",
  "clone": "/srv/operator/repos/worktrees/coderabbit-queue-repo",
  "worktree_root": "/srv/operator/repos/worktrees",
  "worktree_prefix": "coderabbit-queue-",
  "max_starts_per_hour": 5,
  "max_inflight": 2,
  "review_timeout_min": 75,
  "quiet_minutes": 30,
  "rate_limit_default_backoff_min": 30,
  "error_backoff_min": 30,
  "max_item_failures": 3,
  "spawn_addressing": true,
  "address_provider": "claude/claude-sonnet-5-5",
  "address_mode": "bypassPermissions",
  "address_timeout_min": 180,
  "address_severities": [
    "critical",
    "major"
  ],
  "merged_min_survival": 0.25,
  "merged_min_surviving_lines": 15,
  "tick_agent_title_prefix": "crq tick",
  "keep_tick_agents": 3,
  "schedule_id": "schedule-example",
  "merged_min_file_focus": 0.25,
  "promotion": {
    "enabled": true,
    "post_status": true,
    "status_context": "crq/promotion-review",
    "checks": [
      "static",
      "denylist",
      "ratchet"
    ],
    "merges_trigger": 5,
    "hours_trigger": 8,
    "dispatch_after_min": 20,
    "tip_search_depth": 15,
    "poster": "camerontaylor",
    "alert_agent_id": "00000000-0000-4000-8000-000000000004",
    "allowed_reviewers": [],
    "resolver": "conductor (acceptance conductor reviewer-example)",
    "signer": {
      "spool_dir": "/Users/Shared/crq-spool",
      "app_login": null,
      "reviewer_bot_id": null,
      "_identity_source": "ONLY the owner's registration record: toolkit-research/plans/app-registration-session-20261004.md (never a name lookup)"
    },
    "signer_stall_min": 90,
    "signer_down_min": 30
  }
}
