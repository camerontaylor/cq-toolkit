  "cases": [
    {
      "name": "verdicts-and-fix-prs",
      "source": "repair_tick.digest",
      "input": {
        "queue": {
          "items": [
            {
              "id": "i",
              "kind": "open",
              "state": "pending",
              "repair_runs": {
                "r0": {
                  "fix_pr": 42,
                  "verdicts": [
                    {
                      "job": "crq-consumed-F1",
                      "verdict": "FIXED",
                      "attempts": [
                        {
                          "rung": "A1"
                        }
                      ],
                      "judge": {
                        "verdict": "valid"
                      }
                    }
                  ]
                },
                "r1": {
                  "source_publication_error": "boom",
                  "verdicts": [
                    {
                      "job": "j2",
                      "verdict": "NOT-FIXED",
                      "attempts": [
                        {
                          "rung": "A0"
                        }
                      ]
                    }
                  ]
                },
                "r2": {
                  "verdicts": [
                    {
                      "job": "j3",
                      "verdict": "STALE",
                      "attempts": [
                        {
                          "rung": "A2"
                        }
                      ],
                      "judge": {
                        "verdict": "invalid"
                      }
                    }
                  ]
                },
                "r3": {
                  "verdicts": [
                    {
                      "job": "j4",
                      "verdict": "UNKNOWN",
                      "attempts": [
                        {
                          "rung": "A0"
                        }
                      ]
                    }
                  ]
                }
              }
            }
          ],
          "last_tick": "x"
        }
      },
      "expect": {
        "ok": true,
        "value": {
          "verdicts": {
            "fixed@A0": 0,
            "fixed@A1": 1,
            "fixed@A2": 0,
            "not-fixed": 1,
            "stale": 1,
            "judged-valid": 1,
            "judged-invalid": 1,
            "failed": 1
          },
          "inbox": 0,
          "oldest_age_minutes": 0,
          "jobs_in_flight": 0,
          "rate_limit_deferred": 0,
          "orphaned": 10,
          "fix_prs": [
            42
          ],
          "source_publication_errors": [
            {
              "item": "i",
              "run": "r1",
              "error": "boom"
            }
          ]
        },
        "bytes": "{\"verdicts\":{\"fixed@A0\":0,\"fixed@A1\":1,\"fixed@A2\":0,\"not-fixed\":1,\"stale\":1,\"judged-valid\":1,\"judged-invalid\":1,\"failed\":1},\"inbox\":0,\"oldest_age_minutes\":0,\"jobs_in_flight\":0,\"rate_limit_deferred\":0,\"orphaned\":10,\"fix_prs\":[42],\"source_publication_errors\":[{\"item\":\"i\",\"run\":\"r1\",\"error\":\"boom\"}]}"
