{
  "schema": "cq.crq-group-p-vector/v1",
  "family": "backfill-accounting",
  "cases": [
    {
      "name": "empty",
      "source": "backfill_accounting.line_bytes",
      "input": {
        "base64": ""
      },
      "expect": {
        "ok": true,
        "value": []
      }
    },
    {
      "name": "single-newline",
      "source": "backfill_accounting.line_bytes",
      "input": {
        "base64": "Cg=="
      },
      "expect": {
        "ok": true,
        "value": [
          ""
        ]
      }
    },
    {
      "name": "one-line-trailing-newline",
      "source": "backfill_accounting.line_bytes",
      "input": {
        "base64": "YQo="
      },
      "expect": {
        "ok": true,
        "value": [
          "YQ=="
        ]
      }
    },
    {
      "name": "one-line-without-newline",
      "source": "backfill_accounting.line_bytes",
      "input": {
        "base64": "YQ=="
      },
      "expect": {
        "ok": true,
        "value": [
          "YQ=="
        ]
      }
    },
    {
      "name": "blank-line-preserved",
      "source": "backfill_accounting.line_bytes",
      "input": {
        "base64": "YQoK"
      },
      "expect": {
        "ok": true,
        "value": [
          "YQ==",
          ""
        ]
      }
    },
    {
      "name": "crlf-keeps-carriage-return",
      "source": "backfill_accounting.line_bytes",
      "input": {
        "base64": "YQ0K"
      },
      "expect": {
        "ok": true,
        "value": [
          "YQ0="
        ]
      }
    },
    {
      "name": "non-utf8-bytes",
      "source": "backfill_accounting.line_bytes",
      "input": {
        "base64": "/wo="
      },
      "expect": {
        "ok": true,
        "value": [
          "/w=="
        ]
      }
    },
    {
      "name": "zero-is-int",
      "source": "backfill_accounting._int",
      "input": {
        "value": 0,
        "low": 0
      },
      "expect": {
        "ok": true,
        "value": true
      }
    },
    {
      "name": "one-is-int",
      "source": "backfill_accounting._int",
      "input": {
        "value": 1,
        "low": 0
      },
      "expect": {
        "ok": true,
        "value": true
      }
    },
    {
      "name": "negative-is-not",
      "source": "backfill_accounting._int",
      "input": {
        "value": -1,
        "low": 0
      },
      "expect": {
        "ok": true,
        "value": false
      }
    },
    {
      "name": "boolean-is-not-int",
      "source": "backfill_accounting._int",
      "input": {
        "value": true,
        "low": 0
      },
      "expect": {
        "ok": true,
        "value": false
      }
    },
    {
      "name": "float-is-not-int",
      "source": "backfill_accounting._int",
      "input": {
        "value": 1.0,
        "low": 0
      },
      "expect": {
        "ok": true,
        "value": false
      }
    },
    {
      "name": "string-is-not-int",
      "source": "backfill_accounting._int",
      "input": {
        "value": "1",
        "low": 0
      },
      "expect": {
        "ok": true,
        "value": false
      }
    },
    {
      "name": "none-is-not-int",
      "source": "backfill_accounting._int",
      "input": {
        "value": null,
        "low": 0
      },
      "expect": {
        "ok": true,
        "value": false
      }
    },
    {
      "name": "low-bound-is-inclusive",
      "source": "backfill_accounting._int",
      "input": {
        "value": 2,
        "low": 2
      },
      "expect": {
        "ok": true,
        "value": true
      }
    },
    {
      "name": "below-low-bound",
      "source": "backfill_accounting._int",
      "input": {
        "value": 1,
        "low": 2
      },
      "expect": {
        "ok": true,
        "value": false
      }
    },
    {
      "name": "none-is-optional",
      "source": "backfill_accounting._opt_str",
      "input": {
        "value": null
      },
      "expect": {
        "ok": true,
        "value": true
      }
    },
    {
      "name": "string-is-optional",
      "source": "backfill_accounting._opt_str",
