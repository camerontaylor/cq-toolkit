    {
      "name": "coverage-valid",
      "source": "backfill_accounting.FACT_SHAPES",
      "input": {
        "kind": "coverage",
        "value": {
          "covered": {
            "src/a.py": [
              [
                1,
                2
              ]
            ]
          },
          "evidence": {
