              4
            ]
          ]
        }
      },
      "expect": {
        "ok": true,
        "value": false
      }
    },
    {
      "name": "carry-boolean-line",
      "source": "backfill_accounting.FACT_SHAPES",
      "input": {
        "kind": "carry",
        "value": {
