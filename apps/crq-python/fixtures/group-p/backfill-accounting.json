    {
      "name": "lineage-step-valid",
      "source": "backfill_accounting.FACT_SHAPES",
      "input": {
        "kind": "lineage_step",
        "value": {
          "parent": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          "changes": [
            [
              "R100",
