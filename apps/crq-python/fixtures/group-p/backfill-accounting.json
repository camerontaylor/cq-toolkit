    },
    {
      "name": "boolean-is-not",
      "source": "backfill_accounting._opt_str",
      "input": {
        "value": true
      },
      "expect": {
        "ok": true,
        "value": false
      }
    },
    {
      "name": "list-is-not",
      "source": "backfill_accounting._opt_str",
      "input": {
        "value": []
      },
      "expect": {
        "ok": true,
        "value": false
      }
    },
