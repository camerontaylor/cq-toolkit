{
  "schema": "cq.crq-group-p-vector/v1",
  "family": "ledger",
  "cases": [
    {
      "name": "exact-utc",
      "source": "review_ledger.timestamp",
      "input": {
        "value": "2026-11-09T00:00:00Z"
      },
      "expect": {
        "ok": true,
        "value": "2026-11-09T00:00:00+00:00"
      }
    },
    {
      "name": "fraction-refused",
      "source": "review_ledger.timestamp",
      "input": {
        "value": "2026-11-09T00:00:00.5Z"
      },
      "expect": {
        "ok": false,
        "error": "IntegrityError",
        "message": "expected exact UTC timestamp"
      }
    },
    {
      "name": "offset-refused",
      "source": "review_ledger.timestamp",
      "input": {
        "value": "2026-11-09T10:00:00+10:00"
      },
      "expect": {
        "ok": false,
        "error": "IntegrityError",
        "message": "expected exact UTC timestamp"
      }
    },
    {
      "name": "non-string-refused",
      "source": "review_ledger.timestamp",
      "input": {
        "value": 1
      },
      "expect": {
        "ok": false,
        "error": "IntegrityError",
        "message": "expected exact UTC timestamp"
      }
    },
    {
      "name": "nested-path",
      "source": "review_ledger.path",
      "input": {
        "value": "src/ops/crq/tick.ts"
      },
      "expect": {
        "ok": true,
        "value": "src/ops/crq/tick.ts"
      }
    },
    {
      "name": "unicode-path",
      "source": "review_ledger.path",
      "input": {
        "value": "docs/\u96ea.md"
      },
      "expect": {
        "ok": true,
        "value": "docs/\u96ea.md"
      }
    },
    {
      "name": "absolute-refused",
      "source": "review_ledger.path",
      "input": {
        "value": "/etc/passwd"
      },
      "expect": {
        "ok": false,
        "error": "IntegrityError",
        "message": "non-canonical repository path"
      }
    },
    {
      "name": "parent-refused",
      "source": "review_ledger.path",
      "input": {
        "value": "../outside"
      },
      "expect": {
        "ok": false,
        "error": "IntegrityError",
        "message": "non-canonical repository path"
      }
    },
    {
      "name": "backslash-refused",
      "source": "review_ledger.path",
      "input": {
        "value": "src\\win.py"
      },
      "expect": {
        "ok": false,
        "error": "IntegrityError",
        "message": "non-canonical repository path"
      }
    },
    {
      "name": "empty-refused",
      "source": "review_ledger.path",
      "input": {
        "value": ""
      },
      "expect": {
        "ok": false,
        "error": "IntegrityError",
        "message": "non-canonical repository path"
      }
    },
    {
      "name": "single-range",
      "source": "review_ledger.intervals",
      "input": {
        "rows": [
          [
            1,
            3
          ]
        ]
      },
      "expect": {
        "ok": true,
        "value": [
          1,
          2,
          3
        ]
      }
    },
    {
      "name": "adjacent-ranges-merge-into-one-set",
      "source": "review_ledger.intervals",
      "input": {
        "rows": [
          [
            1,
            2
          ],
          [
            3,
            4
          ]
        ]
      },
      "expect": {
        "ok": true,
        "value": [
          1,
          2,
          3,
          4
        ]
      }
    },
    {
      "name": "overlap-refused",
      "source": "review_ledger.intervals",
      "input": {
        "rows": [
          [
            1,
            3
          ],
          [
            3,
            5
          ]
        ]
      },
      "expect": {
        "ok": false,
        "error": "IntegrityError",
        "message": "invalid or overlapping intervals"
      }
    },
    {
      "name": "reversed-refused",
      "source": "review_ledger.intervals",
      "input": {
        "rows": [
          [
            3,
            2
          ]
        ]
      },
      "expect": {
        "ok": false,
        "error": "IntegrityError",
        "message": "invalid or overlapping intervals"
      }
    },
    {
      "name": "zero-start-refused",
      "source": "review_ledger.intervals",
      "input": {
        "rows": [
          [
            0,
            1
          ]
        ]
      },
      "expect": {
        "ok": false,
        "error": "IntegrityError",
        "message": "invalid or overlapping intervals"
      }
    },
    {
      "name": "boolean-refused",
      "source": "review_ledger.intervals",
      "input": {
        "rows": [
          [
            true,
            2
          ]
        ]
      },
      "expect": {
        "ok": false,
        "error": "IntegrityError",
        "message": "invalid or overlapping intervals"
      }
    },
    {
      "name": "scope-keyed-by-path-and-blob",
      "source": "review_ledger.scope",
      "input": {
        "rows": [
          {
            "path": "a.py",
            "blob": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
            "intervals": [
              [
                1,
                2
              ]
            ]
          },
          {
            "path": "b.py",
            "blob": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
            "intervals": [
              [
                5,
                5
              ]
            ]
          }
        ]
      },
      "expect": {
        "ok": true,
        "value": [
          [
            "a.py",
            "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
            [
              1,
              2
            ]
          ],
          [
            "b.py",
            "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
            [
              5
            ]
          ]
        ]
      }
    },
    {
      "name": "duplicate-scope-refused",
      "source": "review_ledger.scope",
      "input": {
        "rows": [
          {
            "path": "a.py",
            "blob": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
            "intervals": [
              [
                1,
                2
              ]
            ]
          },
          {
            "path": "b.py",
            "blob": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
            "intervals": [
              [
                5,
                5
              ]
            ]
          },
          {
            "path": "a.py",
            "blob": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
            "intervals": [
              [
                1,
                2
              ]
            ]
          }
        ]
      },
      "expect": {
        "ok": false,
        "error": "IntegrityError",
        "message": "duplicate scope path/blob"
      }
    },
    {
