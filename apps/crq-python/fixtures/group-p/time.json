{
  "schema": "cq.crq-group-p-vector/v1",
  "family": "time",
  "cases": [
    {
      "name": "zulu-seconds",
      "source": "queue_time.parse_utc",
      "input": {
        "value": "2026-11-08T00:00:00Z"
      },
      "expect": {
        "ok": true,
        "value": {
          "utc": "2026-11-08T00:00:00.000000Z"
        }
      }
    },
    {
      "name": "zulu-fraction",
      "source": "queue_time.parse_utc",
      "input": {
        "value": "2026-11-08T00:00:00.500Z"
      },
      "expect": {
        "ok": true,
        "value": {
          "utc": "2026-11-08T00:00:00.500000Z"
        }
      }
    },
    {
      "name": "numeric-offset",
      "source": "queue_time.parse_utc",
      "input": {
        "value": "2026-11-08T10:00:00.500+10:00"
      },
      "expect": {
        "ok": true,
        "value": {
          "utc": "2026-11-08T00:00:00.500000Z"
        }
      }
    },
    {
      "name": "naive-means-utc",
      "source": "queue_time.parse_utc",
      "input": {
        "value": "2026-11-08T00:00:00.500"
      },
      "expect": {
        "ok": true,
        "value": {
          "utc": "2026-11-08T00:00:00.500000Z"
        }
      }
    },
    {
      "name": "compact-run-suffix",
      "source": "queue_time.parse_utc",
      "input": {
        "value": "20261108T000000.500Z"
      },
      "expect": {
        "ok": true,
        "value": {
          "utc": "2026-11-08T00:00:00.500000Z"
        }
      }
    },
    {
      "name": "negative-offset",
      "source": "queue_time.parse_utc",
      "input": {
        "value": "2026-11-07T19:00:00-05:00"
      },
      "expect": {
        "ok": true,
        "value": {
          "utc": "2026-11-08T00:00:00.000000Z"
        }
      }
    },
    {
      "name": "microseconds",
      "source": "queue_time.parse_utc",
      "input": {
        "value": "2026-11-08T00:00:00.123456Z"
      },
      "expect": {
        "ok": true,
        "value": {
          "utc": "2026-11-08T00:00:00.123456Z"
        }
      }
    },
    {
      "name": "fraction-truncates-to-microseconds",
      "source": "queue_time.parse_utc",
      "input": {
        "value": "2026-11-08T00:00:00.1234567Z"
      },
      "expect": {
        "ok": true,
        "value": {
          "utc": "2026-11-08T00:00:00.123456Z"
        }
      }
    },
    {
      "name": "comma-fraction",
      "source": "queue_time.parse_utc",
      "input": {
        "value": "2026-11-08T00:00:00,5Z"
      },
      "expect": {
        "ok": true,
        "value": {
          "utc": "2026-11-08T00:00:00.500000Z"
        }
      }
    },
    {
      "name": "basic-date-and-time",
      "source": "queue_time.parse_utc",
      "input": {
        "value": "20261108T0000Z"
      },
      "expect": {
        "ok": true,
        "value": {
          "utc": "2026-11-08T00:00:00.000000Z"
        }
      }
    },
    {
      "name": "hour-only",
      "source": "queue_time.parse_utc",
      "input": {
        "value": "2026-11-08T00"
      },
      "expect": {
        "ok": true,
        "value": {
          "utc": "2026-11-08T00:00:00.000000Z"
        }
      }
    },
    {
      "name": "midnight-rollover",
      "source": "queue_time.parse_utc",
      "input": {
        "value": "2026-11-08T24:00:00Z"
      },
      "expect": {
        "ok": true,
        "value": {
          "utc": "2026-11-09T00:00:00.000000Z"
        }
      }
    },
    {
      "name": "lowercase-separator",
      "source": "queue_time.parse_utc",
      "input": {
        "value": "2026-11-08t00:00:00Z"
      },
      "expect": {
        "ok": true,
        "value": {
          "utc": "2026-11-08T00:00:00.000000Z"
        }
      }
    },
    {
      "name": "space-separator",
      "source": "queue_time.parse_utc",
      "input": {
        "value": "2026-11-08 00:00:00Z"
      },
      "expect": {
        "ok": true,
        "value": {
          "utc": "2026-11-08T00:00:00.000000Z"
        }
      }
    },
    {
      "name": "iso-week-without-weekday",
      "source": "queue_time.parse_utc",
      "input": {
        "value": "2026-W45T00:00:00Z"
      },
      "expect": {
        "ok": true,
        "value": {
          "utc": "2026-11-02T00:00:00.000000Z"
        }
      }
    },
    {
      "name": "iso-week-53-exists",
      "source": "queue_time.parse_utc",
      "input": {
        "value": "2026-W53-1"
      },
      "expect": {
        "ok": true,
        "value": {
          "utc": "2026-12-28T00:00:00.000000Z"
        }
      }
    },
    {
      "name": "offset-hour-only",
      "source": "queue_time.parse_utc",
      "input": {
        "value": "2026-11-08T00:00:00+10"
      },
      "expect": {
        "ok": true,
        "value": {
          "utc": "2026-11-07T14:00:00.000000Z"
        }
      }
    },
    {
      "name": "offset-basic",
      "source": "queue_time.parse_utc",
      "input": {
        "value": "2026-11-08T00:00:00+1000"
      },
      "expect": {
        "ok": true,
        "value": {
          "utc": "2026-11-07T14:00:00.000000Z"
        }
      }
    },
    {
      "name": "offset-with-seconds-and-fraction",
      "source": "queue_time.parse_utc",
      "input": {
        "value": "2026-11-08T00:00:00+10:00:30.5"
      },
      "expect": {
        "ok": true,
        "value": {
          "utc": "2026-11-07T13:59:29.500000Z"
        }
      }
    },
    {
      "name": "negative-zero-offset",
      "source": "queue_time.parse_utc",
      "input": {
        "value": "2026-11-08T00:00:00-00:00"
      },
      "expect": {
        "ok": true,
        "value": {
          "utc": "2026-11-08T00:00:00.000000Z"
        }
      }
    },
    {
      "name": "leap-day",
      "source": "queue_time.parse_utc",
      "input": {
        "value": "2024-02-29T00:00:00Z"
      },
      "expect": {
        "ok": true,
        "value": {
          "utc": "2024-02-29T00:00:00.000000Z"
        }
      }
    },
    {
      "name": "non-string",
      "source": "queue_time.parse_utc",
      "input": {
        "value": 123
      },
      "expect": {
        "ok": true,
        "value": {
          "utc": null
        }
      }
    },
    {
      "name": "empty",
      "source": "queue_time.parse_utc",
      "input": {
        "value": ""
      },
      "expect": {
        "ok": true,
        "value": {
          "utc": null
        }
      }
    },
    {
      "name": "garbage",
      "source": "queue_time.parse_utc",
      "input": {
        "value": "garbage"
      },
      "expect": {
        "ok": true,
        "value": {
          "utc": null
        }
      }
    },
    {
      "name": "impossible-month",
      "source": "queue_time.parse_utc",
      "input": {
        "value": "2026-13-08T00:00:00Z"
      },
      "expect": {
        "ok": true,
        "value": {
          "utc": null
        }
      }
    },
    {
      "name": "invalid-leap-day",
      "source": "queue_time.parse_utc",
      "input": {
        "value": "2026-02-29T00:00:00Z"
      },
      "expect": {
        "ok": true,
        "value": {
          "utc": null
        }
      }
    },
    {
      "name": "year-zero",
      "source": "queue_time.parse_utc",
      "input": {
        "value": "0000-01-01T00:00:00Z"
      },
      "expect": {
        "ok": true,
        "value": {
          "utc": null
        }
      }
    },
    {
      "name": "iso-week-53-missing",
      "source": "queue_time.parse_utc",
      "input": {
        "value": "2025-W53-1"
      },
      "expect": {
        "ok": true,
        "value": {
          "utc": null
        }
      }
    },
    {
      "name": "offset-exceeds-day",
      "source": "queue_time.parse_utc",
      "input": {
        "value": "2026-11-08T00:00:00+24:00"
      },
      "expect": {
        "ok": true,
        "value": {
          "utc": null
        }
      }
    },
    {
      "name": "offset-seconds-out-of-range",
      "source": "queue_time.parse_utc",
      "input": {
        "value": "2026-11-08T00:00:00+23:59:60"
      },
      "expect": {
        "ok": true,
        "value": {
          "utc": null
        }
      }
    },
    {
      "name": "fraction-separator-without-digits",
      "source": "queue_time.parse_utc",
      "input": {
        "value": "2026-11-08T00:00:00."
      },
      "expect": {
        "ok": true,
        "value": {
          "utc": null
        }
      }
    },
    {
      "name": "offset-overflow",
      "source": "queue_time.parse_utc",
      "input": {
        "value": "0001-01-01T00:00:00+10:00"
      },
      "expect": {
        "ok": true,
        "value": {
          "utc": null
        }
      }
    },
    {
      "name": "iso-exact-seconds",
      "source": "crq.parse_iso",
      "input": {
        "value": "2026-11-08T00:00:00Z"
      },
      "expect": {
        "ok": true,
        "value": {
          "utc": "2026-11-08T00:00:00.000000Z"
        }
      }
    },
    {
      "name": "iso-strips-zero-milliseconds",
      "source": "crq.parse_iso",
      "input": {
        "value": "2026-11-08T00:00:00.000Z"
      },
      "expect": {
        "ok": true,
        "value": {
          "utc": "2026-11-08T00:00:00.000000Z"
        }
      }
    },
    {
      "name": "iso-non-padded-components",
      "source": "crq.parse_iso",
      "input": {
        "value": "2026-11-8T0:0:0Z"
      },
      "expect": {
        "ok": true,
        "value": {
          "utc": "2026-11-08T00:00:00.000000Z"
        }
      }
    },
    {
      "name": "iso-nonzero-fraction-raises",
      "source": "crq.parse_iso",
      "input": {
        "value": "2026-11-08T00:00:00.500Z"
      },
      "expect": {
        "ok": false,
        "error": "ValueError",
        "message": "time data '2026-11-08T00:00:00.Z' does not match format '%Y-%m-%dT%H:%M:%SZ'"
      }
    },
    {
      "name": "iso-six-digit-fraction-raises",
      "source": "crq.parse_iso",
      "input": {
        "value": "2026-11-08T00:00:00.000000Z"
      },
      "expect": {
        "ok": false,
        "error": "ValueError",
        "message": "time data '2026-11-08T00:00:000Z' does not match format '%Y-%m-%dT%H:%M:%SZ'"
      }
    },
    {
      "name": "iso-four-zero-fraction-shifts-and-raises",
      "source": "crq.parse_iso",
      "input": {
        "value": "2026-11-08T00:00:00.0000Z"
      },
      "expect": {
        "ok": false,
        "error": "ValueError",
        "message": "time data '2026-11-08T00:00:000Z' does not match format '%Y-%m-%dT%H:%M:%SZ'"
      }
    },
    {
      "name": "iso-nonzero-fraction-after-zero-milliseconds-raises",
      "source": "crq.parse_iso",
      "input": {
        "value": "2026-11-08T00:00:00.000123Z"
      },
      "expect": {
        "ok": false,
        "error": "ValueError",
        "message": "time data '2026-11-08T00:00:001Z' does not match format '%Y-%m-%dT%H:%M:%SZ'"
      }
    },
    {
      "name": "iso-offset-raises",
      "source": "crq.parse_iso",
      "input": {
        "value": "2026-11-08T10:00:00+10:00"
      },
      "expect": {
        "ok": false,
        "error": "ValueError",
        "message": "time data '2026-11-08T10:00:00+Z' does not match format '%Y-%m-%dT%H:%M:%SZ'"
      }
    },
    {
      "name": "iso-date-only-raises",
      "source": "crq.parse_iso",
      "input": {
        "value": "2026-11-08"
      },
      "expect": {
        "ok": false,
        "error": "ValueError",
        "message": "time data '2026-11-08Z' does not match format '%Y-%m-%dT%H:%M:%SZ'"
      }
    },
    {
      "name": "iso-trailing-newline-is-trimmed-by-slice",
      "source": "crq.parse_iso",
      "input": {
        "value": "2026-11-08T00:00:00Z\n"
      },
      "expect": {
        "ok": true,
        "value": {
          "utc": "2026-11-08T00:00:00.000000Z"
        }
      }
    },
    {
      "name": "iso-double-z-is-trimmed",
      "source": "crq.parse_iso",
      "input": {
        "value": "2026-11-08T00:00:00ZZ"
      },
      "expect": {
        "ok": true,
        "value": {
          "utc": "2026-11-08T00:00:00.000000Z"
        }
      }
    },
    {
      "name": "iso-none-is-none",
      "source": "crq.parse_iso",
      "input": {
        "value": null
      },
      "expect": {
        "ok": true,
        "value": {
          "utc": null
        }
      }
    },
    {
      "name": "iso-empty-is-none",
      "source": "crq.parse_iso",
      "input": {
        "value": ""
      },
      "expect": {
        "ok": true,
        "value": {
          "utc": null
        }
      }
    }
  ]
}
