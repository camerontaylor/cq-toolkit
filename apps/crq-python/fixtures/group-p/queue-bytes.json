{
  "schema": "cq.crq-group-p-vector/v1",
  "family": "queue-bytes",
  "cases": [
    {
      "name": "insertion-order-is-preserved",
      "source": "crq_repair.atomic",
      "input": {
        "value": {
          "z": 1,
          "a": 2,
          "m": {
            "b": 1,
            "a": 2
          }
        }
      },
      "expect": {
        "ok": true,
        "value": {
          "text": "{\n  \"z\": 1,\n  \"a\": 2,\n  \"m\": {\n    \"b\": 1,\n    \"a\": 2\n  }\n}\n",
          "sha256": "026228e9c616088910b6ae90eca73ff7c5e65958b24e87adb0d89b87f249edaf"
        }
      }
    },
    {
      "name": "ascii-escaping-is-the-default",
      "source": "crq_repair.atomic",
      "input": {
        "value": {
          "emoji": "\ud83d\ude00",
          "unicode": "\u96ea",
          "control": "\u0001"
        }
      },
      "expect": {
        "ok": true,
        "value": {
          "text": "{\n  \"emoji\": \"\\ud83d\\ude00\",\n  \"unicode\": \"\\u96ea\",\n  \"control\": \"\\u0001\"\n}\n",
          "sha256": "24407cfe4fc937f41a75434c2322a382ab74cde9105f5375ff7d36b56742a9ad"
        }
      }
    },
    {
