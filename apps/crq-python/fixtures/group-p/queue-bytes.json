{
  "schema": "cq.crq-group-p-vector/v1",
  "family": "queue-bytes",
  "cases": [
    {
      "name": "insertion-order-is-preserved",
      "source": "crq_repair.atomic",
      "input": {
        "value": {
          "z": 1,
          "a": 2,
          "m": {
            "b": 1,
            "a": 2
          }
        }
      },
      "expect": {
        "ok": true,
        "value": {
          "text": "{\n  \"z\": 1,\n  \"a\": 2,\n  \"m\": {\n    \"b\": 1,\n    \"a\": 2\n  }\n}\n",
          "sha256": "026228e9c616088910b6ae90eca73ff7c5e65958b24e87adb0d89b87f249edaf"
        }
      }
    },
    {
      "name": "ascii-escaping-is-the-default",
      "source": "crq_repair.atomic",
      "input": {
        "value": {
          "emoji": "\ud83d\ude00",
          "unicode": "\u96ea",
          "control": "\u0001"
        }
      },
      "expect": {
        "ok": true,
        "value": {
          "text": "{\n  \"emoji\": \"\\ud83d\\ude00\",\n  \"unicode\": \"\\u96ea\",\n  \"control\": \"\\u0001\"\n}\n",
          "sha256": "24407cfe4fc937f41a75434c2322a382ab74cde9105f5375ff7d36b56742a9ad"
        }
      }
    },
    {
      "name": "python-float-repr-is-preserved",
      "source": "crq_repair.atomic",
      "input": {
        "value": {
          "one": 1.0,
          "tenth": 0.1,
          "negative_zero": -0.0,
          "exponent": 1e+20
        }
      },
      "expect": {
        "ok": true,
        "value": {
          "text": "{\n  \"one\": 1.0,\n  \"tenth\": 0.1,\n  \"negative_zero\": -0.0,\n  \"exponent\": 1e+20\n}\n",
          "sha256": "94064e4ea287edd7a9cfdd9f96a704218ed84292f51f0f9da7217e80fbf6306a"
        }
      }
    },
    {
      "name": "large-integers-are-written-in-full",
      "source": "crq_repair.atomic",
      "input": {
        "value": {
          "safe": 9007199254740991,
          "wide": 9223372036854775808
        }
      },
      "expect": {
        "ok": true,
        "value": {
          "text": "{\n  \"safe\": 9007199254740991,\n  \"wide\": 9223372036854775808\n}\n",
          "sha256": "cbdf40c92135fbe4a8e49f0207476c2d885b117e788ff2ab7e3d0fcb182b160c"
        }
      }
    },
    {
      "name": "empty-containers-and-scalars",
      "source": "crq_repair.atomic",
      "input": {
        "value": {
          "array": [],
          "object": {},
          "none": null,
          "false": false
        }
      },
      "expect": {
        "ok": true,
        "value": {
          "text": "{\n  \"array\": [],\n  \"object\": {},\n  \"none\": null,\n  \"false\": false\n}\n",
          "sha256": "1a9bf458323ce65d98770c04aa6757ab57dfe690e0b7e90ef806a3cb211c2fff"
        }
      }
    },
