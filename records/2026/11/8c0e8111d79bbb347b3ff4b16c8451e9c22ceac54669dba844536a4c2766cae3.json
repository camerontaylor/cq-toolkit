ntry, before the first await, and return that copy.\n\n<details>\n<summary>Suggested fix</summary>\n\n```diff\n   return async (input: FixFindingInput) => {\n+    // Snapshot before the await: the echoed binding must match the dispatched one.\n+    const binding: FixFindingBinding = { ...input.binding };\n     // Reuse the shared finding-item normalization rather than re-mapping.\n```\n\n```diff\n-        binding: input.binding,\n+        binding,\n```\n\n</details>","id":"66f574f55aa48cb0bae801ae29eec061d612cd2a123507126e8622aef578a534","intervals":[[334,334]],"path":"src/ops/review/fixFinding.ts","severity":"minor","source_id":null,"status":"untriaged","title":"Snapshot the binding before the worker await."}],"head":"4f0631550259b69bed860908fa504344909ac209","head_tree":"abb7f3bc68a55f9997bb6d811f9a1e897a531a95","input_scope":[{"blob":"95a5602c64951d05ca1654d26cc26f6e3067a1f6","intervals":[[1,348]],"path":"src/ops/review/fixFinding.ts"}],"job_id":"6cb4860b6115018e29219c57515ba94c07bbaf5e48bf7da447f40058c0d983ce:0","outcome":"completed","paths":[{"baseline":{"method":"projection","reason":"path cluster"},"blob":"95a5602c64951d05ca1654d26cc26f6e3067a1f6","disposition":"included","mode":"100644","path":"src/ops/review/fixFinding.ts","reason":"bounded verified input"}],"policy_digest":"eacd1bcf42a0e72eca72fcf9c1e9c8f97e7c515cd67a8fa7965c966924647693","repo":"camerontaylor/cq-toolkit","requested_scope":[{"blob":"95a5602c64951d05ca1654d26cc26f6e3067a1f6","intervals":[[1,348]],"path":"src/ops/review/fixFinding.ts"}],"reviewed_scope":[{"blob":"95a5602c64951d05ca1654d26cc26f6e3067a1f6","intervals":[[1,348]],"path":"src/ops/review/fixFinding.ts"}],"scope_digest":"8429b5dfb61b36025c8ad9dd6a2f62ba7b017b133c777613a632c0b864fcadd3","source":{"authenticated":true,"id":"backfill-6cb4860b6115018e29219c57515ba94c07bbaf5e48bf7da447f40058c0d983ce-g0-20261115T074616Z","producer":"crq-runner-app","repo":"camerontaylor/cq-toolkit","type":"crq-run"},"subject_id":"6cb4860b6115018e29219c57