{"event_type":"review","id":"27eb8beb7dc2eb9547706f84ede9646bb5b481b0689e3d4a50f1fdf67a1c8b3e","occurred_at":"2026-11-14T18:12:26Z","payload":{"artifacts":[{"location":"/home/ctaylor/.local/share/crq-backfill/artifacts/sha256/a4665baa5edf7e44e17b695f0671e9ba8ac993a9fe0765a866ac39f97466e283","sha256":"a4665baa5edf7e44e17b695f0671e9ba8ac993a9fe0765a866ac39f97466e283"},{"location":"/home/ctaylor/.local/share/crq-backfill/artifacts/sha256/ed7d5f14577a35038de6666d1de984f6a2d493e84f637809f95cd814223a18c8","sha256":"ed7d5f14577a35038de6666d1de984f6a2d493e84f637809f95cd814223a18c8"},{"kind":"git-bundle","location":"/home/ctaylor/.local/share/crq-backfill/artifacts/sha256/e02e749f4743e84773de2bc01d3ab62f2e49cf1e1dd9c9ba6bbb2632839b0210","sha256":"e02e749f4743e84773de2bc01d3ab62f2e49cf1e1dd9c9ba6bbb2632839b0210"},{"location":"/home/ctaylor/.local/share/crq-backfill/artifacts/sha256/5ab5b0dc0e132a1bc1311ef5b7e58f4a1348bde628db914ea591bbb338c65cbe","sha256":"5ab5b0dc0e132a1bc1311ef5b7e58f4a1348bde628db914ea591bbb338c65cbe"},{"location":"/home/ctaylor/.local/share/crq-backfill/artifacts/sha256/fa441b4a6154db36ea7446ef585169a49e7c9fd57ec0cb9c253b7c71364be751","sha256":"fa441b4a6154db36ea7446ef585169a49e7c9fd57ec0cb9c253b7c71364be751"}],"attempt_id":"d83aa47e542cca3058648510c38817b530a635ef752a80cbc166637fb4d85bc1:0:1","base":"30da642662affae87ef5ee6d14df039ba32843fc","completion":{"errors":[],"exit_code":0,"scope_verified":true,"skipped":false,"terminal":true},"findings":[{"anchor_status":"verified","blob":"cbd7554656b5e707784c2f7d184eb50d61109345","body":"**Treat partial address usage as unknown spend in the bulk settlement.**\n\n`addressMany.ts` reads `report.usage` from each address result and marks the leg known whenever that object exists (lines 538-554). `address.ts` adds every dispatch's `result.usage` to `report.usage` in `account()`, including dispatches whose provider supplied no measurement. The bulk path therefore settles a partial total as known spend. This can release a reservation while spend from unmeasured dispatches is still unaccounted for. Later admissions can then exceed the aggregate budget.\n\n`address.ts` already records unmeasured dispatches as unknown in its separate `usageSummary`, which `finish()` attaches on every exit. The bulk settlement does not read that field. Check the unknown-settlement state in `report.usageSummary` (the `KnownUsageSummary` type from `src/shared/knownUsage.js`). Settle the leg as unknown when that state reports any unmeasured dispatch. Keep the known path for reports whose every dispatch was measured.","id":"e84c3bcc92b63af241067fb7761b40d1d9a74bebc8dc29ecf994ef7deed5d5fd","intervals":[[554,554]],"path":"src/ops/review/addressMany.ts","severity":"major","source_id":null,"status":"untriaged","title":"Treat partial address usage as unknown spend in the bulk settlement."}],"head":"4de42b43c2df0bef41c74c18b56705311851ca82","head_tree":"1ecd116c4ac33bbae984033dfd03894947e6454f","input_scope":[{"blob":"cbd7554656b5e707784c2f7d184eb50d61109345","intervals":[[1,794]],"path":"src/ops/review/addressMany.ts"}],"job_id":"d83aa47e542cca3058648510c38817b530a635ef752a80cbc166637fb4d85bc1:0","outcome":"completed","paths":[{"baseline":{"method":"projection","reason":"path cluster"},"blob":"cbd7554656b5e707784c2f7d184eb50d61109345","disposition":"included","mode":"100644","path":"src/ops/review/addressMany.ts","reason":"bounded verified input"}],"policy_digest":"eacd1bcf42a0e72eca72fcf9c1e9c8f97e7c515cd67a8fa7965c966924647693","repo":"camerontaylor/cq-toolkit","requested_scope":[{"blob":"cbd7554656b5e707784c2f7d184eb50d61109345","intervals":[[1,4],[8,8],[85,85],[130,130],[380,383],[413,413],[415,518],[520,694],[696,716]],"path":"src/ops/review/addressMany.ts"}],"reviewed_scope":[{"blob":"cbd7554656b5e707784c2f7d184eb50d61109345","intervals":[[1,4],[8,8],[85,85],[130,130],[380,383],[413,413],[415,518],[520,694],[696,716]],"path":"src/ops/review/addressMany.ts"}],"scope_digest":"d2372376d16948d94f41a2975e01