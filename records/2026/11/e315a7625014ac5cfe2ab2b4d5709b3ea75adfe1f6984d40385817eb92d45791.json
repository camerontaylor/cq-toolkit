a is inconsistent between root and replies.\n\n<details>\n<summary>Proposed fix</summary>\n\n```diff\n       ...chain.map((reply) => ({\n         authorLogin: reply.authorLogin,\n+        authorType: reply.authorType,\n         body: reply.body,\n         createdAt: reply.createdAt,\n       })),\n```\n</details>","id":"942c87fff5c68aa2f332e933291769e95e085c7e1b3f67663e3b6c24c818dd20","intervals":[],"path":"src/ops/review/threads.ts","severity":"minor","source_id":null,"status":"untriaged","title":"Reply `authorType` is dropped in `attachRestReplies`. `src/ops/review/threads.ts:236-242`."}],"head":"d750fd7c7dc44e2cfeb3b7f8b9eca577158c86a8","head_tree":"013c2fa4bf520f2358e9d1367a3d73c21ab4fb44","input_scope":[{"blob":"deb2c54fb340fa281871a9df55c117606e6da67f","intervals":[[1,245]],"path":"src/ops/review/threads.ts"},{"blob":"8176c82abdad6e0b612b00d88fd8208d64b4a7ea","intervals":[[1,79]],"path":"test/fixtures/gh/scenarios/e1-graphql-page2.json"},{"blob":"c756e8c1d3ee6fc774e0c0b863a5527f9b1cbab3","intervals":[[1,79]],"path":"test/fixtures/gh/scenarios/e1-graphql.json"},{"blob":"51d5210c5098b59083bf069f5039338f06bb27ed","intervals":[[1,45]],"path":"test/fixtures/gh/scenarios/e1-lag-graphql.json"},{"blob":"a35ec5dbab98ba6d3abf527193433cb325c62cbc","intervals":[[1,139]],"path":"test/ops/review/gh.test.ts"}],"job_id":"2e14360d1fe464101342b6a926b7954547bff76bf91d3b391ead70dee0d6f86c:0","outcome":"completed","paths":[{"baseline":{"entry":null,"merge":"5c07c6600754c26eca20d2eb2c6770a8bfb41103","method":"pre-merge","pre":"97ab1796bc8a323f48e1a660b665eb239ec5cffc","source_path":"src/ops/review/threads.ts"},"blob":"deb2c54fb340fa281871a9df55c117606e6da67f","disposition":"included","mode":"100644","path":"src/ops/review/threads.ts","reason":"bounded verified input"},{"baseline":{"entry":null,"merge":"5c07c6600754c26eca20d2eb2c6770a8bfb41103","method":"pre-merge","pre":"97ab1796bc8a323f48e1a660b665eb239ec5cffc","source_path":"test/fixtures/gh/scenarios/e1-graphql-page2.json"},"blob