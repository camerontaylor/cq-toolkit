>\n\n```diff\n-  unknown.sort((a, b) => JSON.stringify(a).localeCompare(JSON.stringify(b)));\n+  unknown.sort((a, b) => {\n+    const x = JSON.stringify(a);\n+    const y = JSON.stringify(b);\n+    return x < y ? -1 : x > y ? 1 : 0;\n+  });\n```\n</details>","id":"6cfc738838118af41ca07fa8713117c6445179bf0c4504fda87df2b361fb4917","intervals":[],"path":"scripts/measurement-acceptance.mjs","severity":"minor","source_id":null,"status":"untriaged","title":"Replace `localeCompare` with a locale-independent comparison at Line 126."}],"head":"78464014c358ea5a30d278ee8dc432cbfb37d444","head_tree":"a619b07177492e5c80d4ce45880731ec409f8b2c","input_scope":[{"blob":"41de591968f574f64039b8c4fdd203b3534cd539","intervals":[[1,27]],"path":"scripts/archive-measurement-wrapper.d.mts"},{"blob":"21dd2e327a8e62e7f865046eb23153436f3456ea","intervals":[[1,30]],"path":"scripts/measurement-acceptance.d.mts"},{"blob":"12f790251ca1b52e3be97167256452eb801a178a","intervals":[[1,128]],"path":"scripts/measurement-acceptance.mjs"},{"blob":"5c72a33952f545c783d5a3d36eacd2dcb46fb2a4","intervals":[[1,79]],"path":"scripts/measurement-inputs.d.mts"},{"blob":"d56609153061cc1be579344c0619dad090d75c58","intervals":[[1,82]],"path":"scripts/measurement-metrics.d.mts"},{"blob":"13c93ce07d73b66954860ae165912d457fddce56","intervals":[[1,67]],"path":"scripts/measurement-outcomes.d.mts"},{"blob":"4f74048d5715555f5b49597823cb7d2c9f41b8e6","intervals":[[1,54]],"path":"scripts/measurement-rollup.d.mts"},{"blob":"21a2af0406b269063ecf422cee0fdadec4d1b521","intervals":[[1,59]],"path":"scripts/measurement-session-index.d.mts"}],"job_id":"65eb611812c15768af41ca10e63673d4b7630db3cd55b475f5b2a0aaabe96176:0","outcome":"completed","paths":[{"baseline":{"method":"projection","reason":"path cluster"},"blob":"41de591968f574f64039b8c4fdd203b3534cd539","disposition":"included","mode":"100644","path":"scripts/archive-measurement-wrapper.d.mts","reason":"bounded verified input"},{"baseline":{"method":"projection","reason":"path clus