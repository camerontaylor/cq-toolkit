 dirty path under the workspace can be ignored. Normalize dot segments before validation and reject prefixes whose resolved base equals `root`.\n\nThe default attended prefix is the fixed `.cq/` value. However, `AttendedApprovalConfig.exempt` and `GitApprovalStateReaderOptions.exempt` accept configured values, so the inspected source does not establish that untrusted user input reaches this option.","id":"4b67e55fa6d0ea9219a534f3da5849e1b607aaa6c34a202e70242443915ef40a","intervals":[],"path":"src/ops/analyze/approval.ts","severity":"major","source_id":null,"status":"untriaged","title":"Reject prefixes that resolve to the workspace root (`src/ops/analyze/approval.ts:467-469`)."}],"head":"f4db7654d6b6f2b5a1ff53e07cdecd98c2d5699e","head_tree":"013c2fa4bf520f2358e9d1367a3d73c21ab4fb44","input_scope":[{"blob":"3dd2b3e399cd8bc48a25fdf5a0532150baae6036","intervals":[[30,30]],"path":"src/adapters/forge-github/ratchetEffects.ts"},{"blob":"88f373beb397ec0aef18d69f6fcdd6ad1a3884f4","intervals":[[35,35]],"path":"src/adapters/git/cleanup.ts"},{"blob":"fbcb460a3144df370f8becabe2daa949cc6f8b93","intervals":[[31,31],[930,933]],"path":"src/adapters/git/worktreeFor.ts"},{"blob":"fa3c672ac97ec2f4b7dca045863f8c1ae8d07b10","intervals":[[263,263],[317,318],[344,344],[380,380],[815,820],[864,866],[883,888],[930,931],[1779,1782],[1851,1851],[1855,1855]],"path":"src/driver/acp/index.ts"},{"blob":"0ac6f38d70b45a0bcad3dcf5cb89e2432efa6369","intervals":[[7,7],[148,148],[171,174],[178,178],[282,352],[428,428],[1063,1073],[1269,1284],[1292,1296],[1486,1486],[1500,1514],[1527,1531],[1692,1698],[1707,1709],[1772,1777]],"path":"src/kernel/runner.ts"},{"blob":"19a780a4c0596ac8dea4cfaca785c5cfb8d39c49","intervals":[[47,47]],"path":"src/ops/analyze/analysisStore.ts"},{"blob":"6130a9286dce2f9d040f0d709dcf47215627eec6","intervals":[[71,71],[495,506],[509,509],[588,589],[592,596]],"path":"src/ops/analyze/applyRemediation.ts"},{"blob":"cb7a6f0615f2667afebe7fd94c96f3f07c2a5c97","intervals":[[73,73],[77,77]