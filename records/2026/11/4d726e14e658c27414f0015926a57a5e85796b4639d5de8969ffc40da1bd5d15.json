 item subject. A clean worktree then passes the publish-time dirty check, so the partial change can be pushed to that item's thread.\n\nRestore the worktree to its pre-job state after a job that ends without a commit. Discard tracked changes and remove untracked files the job created, and leave earlier commits unchanged. Enforce this in the runner. The prompt alone cannot guarantee it.","id":"0e341009bdbb12aa1a530c92ec3c7ca2db61d14a06315638d8c6c74ffedecf24","intervals":[[35,36]],"path":"src/ops/review/prompts/fix.default.md","severity":"major","source_id":null,"status":"untriaged","title":"Discard uncommitted edits left by a `nooutcome` fix job before the next job runs."}],"head":"4d9cfee5e625a2fef6431500abf4ca13a5a50e0e","head_tree":"59a8e4bccb16679adcf515ad27331e6995a154f0","input_scope":[{"blob":"c28de6d98164079b24a093847ea08473d5985730","intervals":[[1,61]],"path":"src/ops/review/prompts/fix.default.md"}],"job_id":"1b43f5ab46eef9b2b51757ef2fa3fc114e4acf7dce76a43402717f2c668b3b60:0","outcome":"completed","paths":[{"baseline":{"method":"projection","reason":"path cluster"},"blob":"c28de6d98164079b24a093847ea08473d5985730","disposition":"included","mode":"100644","path":"src/ops/review/prompts/fix.default.md","reason":"bounded verified input"}],"policy_digest":"eacd1bcf42a0e72eca72fcf9c1e9c8f97e7c515cd67a8fa7965c966924647693","repo":"camerontaylor/cq-toolkit","requested_scope":[{"blob":"c28de6d98164079b24a093847ea08473d5985730","intervals":[[27,32]],"path":"src/ops/review/prompts/fix.default.md"}],"reviewed_scope":[{"blob":"c28de6d98164079b24a093847ea08473d5985730","intervals":[[27,32]],"path":"src/ops/review/prompts/fix.default.md"}],"scope_digest":"2e39e4bd32ef5875e36f8a31b010dae31ccfa398c2ecd1631fb79aed0f099159","source":{"authenticated":true,"id":"backfill-1b43f5ab46eef9b2b51757ef2fa3fc114e4acf7dce76a43402717f2c668b3b60-g0-20261115T200918Z","producer":"crq-runner-app","repo":"camerontaylor/cq-toolkit","type":"crq-run"},"subject_id":"1b43f5ab46eef9b2b51757ef2fa3