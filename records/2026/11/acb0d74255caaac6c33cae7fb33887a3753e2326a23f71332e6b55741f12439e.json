ceipt can abort `merged_current` instead of incrementing `unverified`.\n\nAdd a receipt API that hashes and parses the same byte snapshot, then use its parsed document here. Preserve the existing manifest/chunk API. If shape validation remains deferred, also catch `AttributeError`.","id":"42eda534fee426765c3a24a7232665e74fd027d503c708a0556b2afd4280c7e6","intervals":[],"path":"apps/crq-python/status_summary.py","severity":"minor","source_id":null,"status":"untriaged","title":"Use one validated receipt snapshot."}],"head":"eee624d7c813c42e8052e25bf2bbaec32f24e5a6","head_tree":"013c2fa4bf520f2358e9d1367a3d73c21ab4fb44","input_scope":[{"blob":"670d968eda5e1f6bec131a0497edfca32126d5a3","intervals":[[67,69]],"path":"apps/crq-python/PROVENANCE.md"},{"blob":"0ba88d70f0bdad84604516bc0437aee719158187","intervals":[[15,62],[97,113]],"path":"apps/crq-python/README.md"},{"blob":"83cc38bf0716c2b073fe481bddfa22bc32d01811","intervals":[[4,4],[32,108],[111,114],[141,144],[146,146],[150,150],[260,260],[263,263]],"path":"apps/crq-python/status_summary.py"},{"blob":"87adda22b2aedff836f1b781e5d827c454822c4c","intervals":[[153,153],[167,167],[214,233],[241,242],[470,471],[508,508],[518,533],[583,584],[629,637],[705,707],[709,709],[711,711],[734,797],[903,904],[906,907],[991,1096]],"path":"apps/crq-python/test_author_quota.py"},{"blob":"4bfeb2ffbd5e4cd16cd2e8af10b6d0c8fa23a16f","intervals":[[19,26],[28,47],[166,244]],"path":"apps/crq-python/test_status_summary.py"}],"job_id":"63d8e5d9163c6346282abd7ceb081248c0dcc8028e15541718c9ef9d14751794:0","outcome":"completed","paths":[{"baseline":{"entry":{"blob":"7cb14c9a27988b62b170d1c1d9957214660532a6","kind":"blob","mode":"100644","path":"apps/crq-python/PROVENANCE.md"},"merge":"8966f1b196a5be24d9ab09f4a4d760c3bfb5b745","method":"pre-merge","pre":"8fc58c222a6ef018e64427a4509c38f5d96ec8e4","source_path":"apps/crq-python/PROVENANCE.md"},"blob":"670d968eda5e1f6bec131a0497edfca32126d5a3","disposition":"included","mode":"100644","path":"apps/crq-pytho