rc/kernel/types.ts:124-125).\n\nThis file is the frozen source of truth. A reader of this comment will assume that `maxUsd` is not enforced. Update the comment so it states that the governor enforces the cap against observed cost. Make the \"Derived-only\" wording on `JobOutcome.costUSD` (src/kernel/types.ts:149) consistent with the \"observed\" wording at src/kernel/types.ts:303.\n\n<details>\n<summary>Proposed doc fix</summary>\n\n```diff\n-  /** Run-level USD cap (advisory here: USD is derived, callers govern). */\n+  /** Run-level USD cap: the governor enforces it against observed cost (reportUsage/reportCost); never kernel-derived. */\n```\n</details>","id":"9b677efb90f81cc422ed31c7e5b15c2c7650abfcb7ef2596cacd37aa860882b5","intervals":[[120,121]],"path":"src/kernel/types.ts","severity":"minor","source_id":null,"status":"untriaged","title":"Fix the `maxUsd` doc. It contradicts the governor contract."}],"head":"06e78b8838c7c6dc6ed30c7eb16073aad36c70da","head_tree":"df3263d3bcbdb1bef920209c9d76e07c2e9ce437","input_scope":[{"blob":"f41ebc92352d426d5a54238f499f35c415e6554c","intervals":[[1,1110]],"path":"src/kernel/types.ts"}],"job_id":"0eeb5a5ccb60a31e37c25cf2de887324c5e949c5e5b2b5ceb3f46fcc92d01498:0","outcome":"completed","paths":[{"baseline":{"method":"projection","reason":"path cluster"},"blob":"f41ebc92352d426d5a54238f499f35c415e6554c","disposition":"included","mode":"100644","path":"src/kernel/types.ts","reason":"bounded verified input"}],"policy_digest":"eacd1bcf42a0e72eca72fcf9c1e9c8f97e7c515cd67a8fa7965c966924647693","repo":"camerontaylor/cq-toolkit","requested_scope":[{"blob":"f41ebc92352d426d5a54238f499f35c415e6554c","intervals":[[1093,1093],[1098,1099],[1108,1109]],"path":"src/kernel/types.ts"}],"reviewed_scope":[{"blob":"f41ebc92352d426d5a54238f499f35c415e6554c","intervals":[[1093,1093],[1098,1099],[1108,1109]],"path":"src/kernel/types.ts"}],"scope_digest":"33213f99e682ca3953808ae0463d5492ffacd5bb9fe3da11af0afc5f7f5f4195","source":{"authenticated":true