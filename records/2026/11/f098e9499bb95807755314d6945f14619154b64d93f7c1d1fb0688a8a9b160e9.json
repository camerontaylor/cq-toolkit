es propagate so generation fails. Check the malformed-input cases (`source-not-string`, `line-bool`, `start-bool`) before narrowing, because they may raise non-`ValueError` types.","id":"8e8ad05293e863c652d0cdd8e7909dfc0707202037bbd7d9af8ac81382af76c4","intervals":[[143,144]],"path":"apps/crq-python/repair_request_vectors.py","severity":"minor","source_id":null,"status":"untriaged","title":"Record only `ValueError` refusals in the fixture oracle."}],"head":"a6133b7a8875051f85b1aec353cb5206aeb0b444","head_tree":"43352e314f3c3a14ad68477aef868d1a2c87fd92","input_scope":[{"blob":"b615ddddf039f13c67fd6b109941a94f0b85b1ef","intervals":[[1,189]],"path":"apps/crq-python/backfill_report.py"},{"blob":"61c579477d47c72f33c1d1b679ed02f4f70a5c13","intervals":[[1,453]],"path":"apps/crq-python/finding_issues_vector_emit_b1.py"},{"blob":"a4df7eeec77fa813fcb347fa19d2d9848b38fbdd","intervals":[[1,506]],"path":"apps/crq-python/repair_prepare_execution_vectors.py"},{"blob":"d4c1275a5239e80335def25bbe8c06063ecc240f","intervals":[[1,372]],"path":"apps/crq-python/repair_request_vectors.py"},{"blob":"df52c2c5772f8f92c151bacb761caa2dd1275dc9","intervals":[[1,257]],"path":"apps/crq-python/test_backfill_report.py"},{"blob":"7c78fb3bcfee2788a6758defe079758ed77b3148","intervals":[[1,181]],"path":"apps/crq-python/test_finding_issues_vector_emit_b1.py"},{"blob":"3903d4e7d4b5d34bda0313f9d99814559b6a218e","intervals":[[1,400]],"path":"apps/crq-python/test_host_config_units.py"},{"blob":"f252f3f20532961d075af057ba9776ca43f740a7","intervals":[[1,140]],"path":"apps/crq-python/test_repair_prepare_execution_vectors.py"}],"job_id":"2d702ba9adb6bbf31282847657d8de22c20dfb30e16589ac26984c24c38cd67d:0","outcome":"completed","paths":[{"baseline":{"method":"projection","reason":"path cluster"},"blob":"b615ddddf039f13c67fd6b109941a94f0b85b1ef","disposition":"included","mode":"100644","path":"apps/crq-python/backfill_report.py","reason":"bounded verified input"},{"baseline":{"method":"projection","reason":"path c