aseline comes from the new one. The stricter-baseline comparison at lines 371-373 then uses a baseline from a commit other than the one judged. This can skip the subject's own tightening for that run.\n\nThe CLI boundary does not require a commit SHA for `subject`. Both `VerifyRatchetCommandInputSchema` and the selfhost `ArgsSchema` accept any non-empty string. Only `trustRef` is pinned to 40 hex digits.\n\nPass the resolved `subject` SHA into `judgeRatchet`, and read the subject baseline from that SHA at line 332.","id":"1f2a8850090e33d6fc69f4eba5a1d67e9987ef30ae0a360c852206d4776f05bd","intervals":[[332,332]],"path":"src/ops/ratchet/verifyRatchet.ts","severity":"minor","source_id":null,"status":"untriaged","title":"Pin the subject baseline read to the resolved commit."}],"head":"ea3a91362b5df6e70c630da3a271b3b2f0bb5467","head_tree":"1ecd116c4ac33bbae984033dfd03894947e6454f","input_scope":[{"blob":"3740ac68c34abb3611e3ff2b29c5eee8b7513a04","intervals":[[1,524]],"path":"src/ops/ratchet/verifyRatchet.ts"}],"job_id":"e3bca1351287847273ebd738efe7e5de9710b1c2534c0aa3d45dd4df0d406add:0","outcome":"completed","paths":[{"baseline":{"method":"projection","reason":"missing/ambiguous baseline lineage"},"blob":"3740ac68c34abb3611e3ff2b29c5eee8b7513a04","disposition":"included","mode":"100644","path":"src/ops/ratchet/verifyRatchet.ts","reason":"bounded verified input"}],"policy_digest":"eacd1bcf42a0e72eca72fcf9c1e9c8f97e7c515cd67a8fa7965c966924647693","repo":"camerontaylor/cq-toolkit","requested_scope":[{"blob":"3740ac68c34abb3611e3ff2b29c5eee8b7513a04","intervals":[[237,256],[285,287],[427,427],[433,434],[454,457],[459,460],[462,464],[478,478]],"path":"src/ops/ratchet/verifyRatchet.ts"}],"reviewed_scope":[{"blob":"3740ac68c34abb3611e3ff2b29c5eee8b7513a04","intervals":[[237,256],[285,287],[427,427],[433,434],[454,457],[459,460],[462,464],[478,478]],"path":"src/ops/ratchet/verifyRatchet.ts"}],"scope_digest":"85098712e88b1851db635a597ad487f2467abd57b516bd516db83e0252cec93d","sourc