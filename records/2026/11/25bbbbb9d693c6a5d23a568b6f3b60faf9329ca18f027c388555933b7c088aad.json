patch input bound.\n\n<details>\n<summary>Suggested fix</summary>\n\n```diff\n-that crosses the ceiling has already been sent; use `strictTokenBudget` for a\n-pre-request guarantee. Either stop settles `stopReason: 'budget'` and appends\n+that crosses the ceiling has already been sent. Use `strictTokenBudget.maxInputTokens`\n+for a pre-request input guarantee. Either stop settles `stopReason: 'budget'` and appends\n```\n\n</details>","id":"0f2aad0b1af61d74f5106c0a1f7a3acbeb345901da7967405e56149b1ee885e5","intervals":[[80,81]],"path":"src/driver/README.md","severity":"minor","source_id":null,"status":"untriaged","title":"Name `maxInputTokens` as the pre-dispatch bound in the strict budget guidance."}],"head":"8a8488200f6a3e6d85309157ee1c53e9fb661f78","head_tree":"ff441c47f135816927d2c105b0555b66502df3d8","input_scope":[{"blob":"db886c292998b98125ced6cdd8fd6cd9de84bf0b","intervals":[[1,594]],"path":"src/driver/README.md"}],"job_id":"f6c84187018aafe043c1a4c3d10062918b739d03e9d70b172e459f8a7e81e1a8:0","outcome":"completed","paths":[{"baseline":{"method":"projection","reason":"residual uncovered lines"},"blob":"db886c292998b98125ced6cdd8fd6cd9de84bf0b","disposition":"included","mode":"100644","path":"src/driver/README.md","reason":"bounded verified input"}],"policy_digest":"eacd1bcf42a0e72eca72fcf9c1e9c8f97e7c515cd67a8fa7965c966924647693","repo":"camerontaylor/cq-toolkit","requested_scope":[{"blob":"db886c292998b98125ced6cdd8fd6cd9de84bf0b","intervals":[[394,394],[412,412]],"path":"src/driver/README.md"}],"reviewed_scope":[{"blob":"db886c292998b98125ced6cdd8fd6cd9de84bf0b","intervals":[[394,394],[412,412]],"path":"src/driver/README.md"}],"scope_digest":"445966facdb01dde90224abac5176841271899dde67e091da31ddae0f27a0d8f","source":{"authenticated":true,"id":"backfill-f6c84187018aafe043c1a4c3d10062918b739d03e9d70b172e459f8a7e81e1a8-g0-20261114T140616Z","producer":"crq-runner-app","repo":"camerontaylor/cq-toolkit","type":"crq-run"},"subject_id":"f6c84187018aafe043c1a4c3d100629