assified as outside. `SessionStore` then creates its session files in that directory, which is inside the model-editable tree.\n\nCompare the bound workspace with each existing ancestor of the sessions directory by device and inode (`statSync` `dev` and `ino`). Keep the lexical rejection for ordinary inside-workspace paths, and keep sibling and unrelated directories accepted.","id":"de3ac902ec29f259eb137e5b11781924aa427cb773af11c6e498036101767ed5","intervals":[[103,103]],"path":"src/driver/common/workspace.ts","severity":"minor","source_id":null,"status":"untriaged","title":"Compare the sessions directory with the workspace by file identity, not path spelling."}],"head":"cbbb6e3f0df33e9fa9008523d744a24409b29ca1","head_tree":"12e1095fbecea104e28eb07c86b1760f1f72bd77","input_scope":[{"blob":"6942b292d7c61bed9c872f77a31c1f2b4818c6a5","intervals":[[1,140]],"path":"src/driver/common/workspace.ts"}],"job_id":"4bcc2873136c2575e63ae164795b82dcc9bcaab559c560410691eb44250c8d9c:0","outcome":"completed","paths":[{"baseline":{"method":"projection","reason":"path cluster"},"blob":"6942b292d7c61bed9c872f77a31c1f2b4818c6a5","disposition":"included","mode":"100644","path":"src/driver/common/workspace.ts","reason":"bounded verified input"}],"policy_digest":"eacd1bcf42a0e72eca72fcf9c1e9c8f97e7c515cd67a8fa7965c966924647693","repo":"camerontaylor/cq-toolkit","requested_scope":[{"blob":"6942b292d7c61bed9c872f77a31c1f2b4818c6a5","intervals":[[2,2],[28,109]],"path":"src/driver/common/workspace.ts"}],"reviewed_scope":[{"blob":"6942b292d7c61bed9c872f77a31c1f2b4818c6a5","intervals":[[2,2],[28,109]],"path":"src/driver/common/workspace.ts"}],"scope_digest":"c766882e4d99da190994048c1264333ca1e0933c784c44601fd2ba1c86125a93","source":{"authenticated":true,"id":"backfill-4bcc2873136c2575e63ae164795b82dcc9bcaab559c560410691eb44250c8d9c-g0-20261115T173919Z","producer":"crq-runner-app","repo":"camerontaylor/cq-toolkit","type":"crq-run"},"subject_id":"4bcc2873136c2575e63ae164795b82dcc9bcaab559c56041069