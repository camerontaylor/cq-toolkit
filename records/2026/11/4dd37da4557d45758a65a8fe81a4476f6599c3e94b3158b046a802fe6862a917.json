g zeros, so such ids\n- * stay strings), which makes the integer form recoverable exactly.\n+ * cluster id (`--clusterId=12345678`) arrives as a NUMBER. Leading-zero ids\n+ * stay strings because JSON rejects them. Only an eight-digit integer can\n+ * be recovered without guessing.\n@@\n-    typeof value === 'number' && Number.isSafeInteger(value) && value >= 0 && value <= 99_999_999\n-      ? String(value).padStart(8, '0')\n+    typeof value === 'number' && Number.isSafeInteger(value) && value >= 10_000_000 && value <= 99_999_999\n+      ? String(value)\n```\n\n</details>","id":"f2b9fc754794b2a945490b64945e9f5f690412d2da710a7a98787b1e5a60030b","intervals":[],"path":"src/ops/analyze/registry.ts","severity":"major","source_id":null,"status":"untriaged","title":"Reject numeric cluster IDs shorter than eight digits."}],"head":"9f3c697a2d155c3f2e33bac01412a5d66171dccb","head_tree":"5a2179fb215610b97f73524380c02df5f0105de8","input_scope":[{"blob":"7263e56698be5c541dbf96fb5dc949fcfb539401","intervals":[[1,764]],"path":"src/ops/analyze/registry.ts"}],"job_id":"88d3b142fdb31d94ce1d14b30ff791b9d0a5907b9510685db42fbcf48b6478e1:0","outcome":"completed","paths":[{"baseline":{"method":"projection","reason":"path cluster"},"blob":"7263e56698be5c541dbf96fb5dc949fcfb539401","disposition":"included","mode":"100644","path":"src/ops/analyze/registry.ts","reason":"bounded verified input"}],"policy_digest":"eacd1bcf42a0e72eca72fcf9c1e9c8f97e7c515cd67a8fa7965c966924647693","repo":"camerontaylor/cq-toolkit","requested_scope":[{"blob":"7263e56698be5c541dbf96fb5dc949fcfb539401","intervals":[[360,366]],"path":"src/ops/analyze/registry.ts"}],"reviewed_scope":[{"blob":"7263e56698be5c541dbf96fb5dc949fcfb539401","intervals":[[360,366]],"path":"src/ops/analyze/registry.ts"}],"scope_digest":"a75841265bf0541ce5dd18d763d3185660f8e3094f50c49d06b1510a1a114b8e","source":{"authenticated":true,"id":"backfill-88d3b142fdb31d94ce1d14b30ff791b9d0a5907b9510685db42fbcf48b6478e1-g0-20261107T145417Z","producer":