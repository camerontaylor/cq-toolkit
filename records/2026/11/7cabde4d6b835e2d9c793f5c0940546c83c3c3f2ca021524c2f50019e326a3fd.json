v.js';\n import { PlanSchema } from '../kernel/schema.js';\n```\n\n```diff\n-  opts?: { opsRoot?: string; plansRoot?: string; failOnVerdict?: boolean },\n+  opts?: { opsRoot?: string; plansRoot?: string; failOnVerdict?: boolean; cqEnv?: CqEnv },\n```\n\n```diff\n-  const imported = await entry.importer();\n+  const imported = await entry.importer(opts?.cqEnv !== undefined ? { cqEnv: opts.cqEnv } : {});\n```\n\n</details>","id":"040e5ecc83a35ffc1564df112fe06ffcf4322c36aa6fa778db7e8121f6ae9ca1","intervals":[[65,65]],"path":"src/cli/plans.ts","severity":"minor","source_id":null,"status":"untriaged","title":"Pass the resolved configuration to the plan importer."}],"head":"0c762c620d3171e86f298df72268ff0456a4c4a5","head_tree":"013c2fa4bf520f2358e9d1367a3d73c21ab4fb44","input_scope":[{"blob":"aac3c3c508174084d31548344b04942dc628c2cb","intervals":[[1,151]],"path":"src/cli/exit.ts"},{"blob":"755246b0e23c8aef3c401519a396a1ab31ab6403","intervals":[[1,76]],"path":"src/cli/plans.ts"}],"job_id":"d35cbb6aae12afd74cc5a41cc9a16df5e078564d4f9c0b6b96df5c981a6a9d26:0","outcome":"completed","paths":[{"baseline":{"method":"projection","reason":"path cluster"},"blob":"aac3c3c508174084d31548344b04942dc628c2cb","disposition":"included","mode":"100644","path":"src/cli/exit.ts","reason":"bounded verified input"},{"baseline":{"method":"projection","reason":"path cluster"},"blob":"755246b0e23c8aef3c401519a396a1ab31ab6403","disposition":"included","mode":"100644","path":"src/cli/plans.ts","reason":"bounded verified input"}],"policy_digest":"3aee477168e1da8e2aa232a98e80747d98da8f26f54f2a27e0c62d13e349d4b1","repo":"camerontaylor/cq-toolkit","requested_scope":[{"blob":"aac3c3c508174084d31548344b04942dc628c2cb","intervals":[[1,151]],"path":"src/cli/exit.ts"},{"blob":"755246b0e23c8aef3c401519a396a1ab31ab6403","intervals":[[1,76]],"path":"src/cli/plans.ts"}],"reviewed_scope":[{"blob":"aac3c3c508174084d31548344b04942dc628c2cb","intervals":[[1,151]],"path":"src/cli/exit.ts"},{"blob":"755246b0e23c8aef3c