 run, so this affects only direct invocation.\n\n<details>\n<summary>Proposed fix</summary>\n\n```diff\n-if __name__ == \"__main__\":\n-    unittest.main()\n-\n-\n class MergedCurrentSummaryTest(unittest.TestCase):\n```\n\nAdd this at the end of the file:\n\n```diff\n+\n+if __name__ == \"__main__\":\n+    unittest.main()\n```\n</details>","id":"7be88a3f8837468c602f6e0d848460bd718154665861eafa5acafffe821e5ff8","intervals":[],"path":"apps/crq-python/test_status_summary.py","severity":"minor","source_id":null,"status":"untriaged","title":"Move the `unittest.main()` guard to the end of `teststatussummary.py`."}],"head":"df3538c4bd9be2033d20f0795bba5b2049810b12","head_tree":"b4ccd79a879cd59b7eca92377c3b119eff95db28","input_scope":[{"blob":"3313cceb88037081e98fc526b9461c7129626747","intervals":[[1,280]],"path":"apps/crq-python/README.md"},{"blob":"a3773641a9c2fe679ca841e454031706270c3f18","intervals":[[1,283]],"path":"apps/crq-python/test_status_summary.py"}],"job_id":"75ede763d2906768f5ef9092f9c7b1e0cdb1f3d6311d295ff99ada510ed0f014:0","outcome":"completed","paths":[{"baseline":{"method":"projection","reason":"residual uncovered lines"},"blob":"3313cceb88037081e98fc526b9461c7129626747","disposition":"included","mode":"100644","path":"apps/crq-python/README.md","reason":"bounded verified input"},{"baseline":{"method":"projection","reason":"residual uncovered lines"},"blob":"a3773641a9c2fe679ca841e454031706270c3f18","disposition":"included","mode":"100644","path":"apps/crq-python/test_status_summary.py","reason":"bounded verified input"}],"policy_digest":"eacd1bcf42a0e72eca72fcf9c1e9c8f97e7c515cd67a8fa7965c966924647693","repo":"camerontaylor/cq-toolkit","requested_scope":[{"blob":"3313cceb88037081e98fc526b9461c7129626747","intervals":[[86,87],[93,97],[114,115],[119,123],[169,171],[177,178],[181,220],[225,233]],"path":"apps/crq-python/README.md"},{"blob":"a3773641a9c2fe679ca841e454031706270c3f18","intervals":[[63,87],[110,112],[139,140]],"path":"apps/crq-python/test_status_s