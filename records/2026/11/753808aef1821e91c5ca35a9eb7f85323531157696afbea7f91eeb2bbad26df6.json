{"event_type":"finding-event","id":"753808aef1821e91c5ca35a9eb7f85323531157696afbea7f91eeb2bbad26df6","occurred_at":"2026-11-18T00:40:15Z","payload":{"action":"confirmed","actor":"crq-triage/opencode-go/deepseek-v4.1-flash","evidence":{"anchor_verified":true,"failure_class":"evidence","mapped_intervals":[[356,360]],"mapped_path":"src/policy/crq/reviewAdmission.ts","quoted_text":"  if (action === 'observed' && adequate(item) && !input.verifyReceipt(item)) {\n    result = withObjectKeys(result, [\n      ['next_action', 'resubmit'],\n      ['reason', 'receipt-unavailable'],\n    ]);","reason":"The receipt-unavailable branch only decorates the immediate `result`; it does not persist a durable flag or recheck the receipt when `reviewStatus` projects later responses. A replay of the same request therefore loses the `resubmit`/`receipt-unavailable` recovery instruction, which is an implementation defect in the intended recovery behavior.","target":"33ff78cef8138f7ae362d9ad03dc5ca60a7cc2c9"},"finding_id":"d799cc47e2aa464fa154022c0c3515e517be33c7602e6e9cfe6438a769831799","previous_event_id":"903e90401fa6b0e37d487a464468e722f6926cab943de1be9d98cb0bcc3c7880","review_id":"19859068a56813567c6bec1dfeb03e9fbdf22d68ee5a99b882939cb2337191b5"},"schema":"cq.review-ledger/v1","source_key":"finding:d799cc47e2aa464fa154022c0c3515e517be33c7602e6e9cfe6438a769831799:0b4304c1dd01cab916babf7aa4054bab6d0ac084d6729ab7f5b7dd4041dc5a8a"}