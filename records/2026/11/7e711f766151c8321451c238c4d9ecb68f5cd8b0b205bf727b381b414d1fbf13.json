ed. The completion record then reports the selected artifact digest, not the digest of the tree that actually ran.\n\nAdd the selected whole-artifact identity to `expected_render`, and compare that same field in `install()` against the preflight render. Keep the proposed change to these two comparisons. The exact comparison shape depends on the full `artifact_identity()` output, which was not inspected.","id":"ac452001661e1bbf745d053fbaf6fdff906e1d45b86c82fa0514c163fdda8bfd","intervals":[[248,252]],"path":"apps/crq-python/ops/unit-switch-factory.py","severity":"major","source_id":null,"status":"untriaged","title":"Bind the selected Node artifact identity in preflight and install."}],"head":"25b25eb02c292213f61b2e04280c8b81ae8ae4c3","head_tree":"bda143e5c3801b7c35ed31c000807c5f716cf6f6","input_scope":[{"blob":"68a698b7db40bf46f21c67c1a80251915bac00e9","intervals":[[1,287]],"path":"apps/crq-python/ops/unit-switch-factory.py"}],"job_id":"7fb626e2e5b9b75f6efd0ee887d18b83a98b041c93f8a1ae2d48b9c96beb0c3a:0","outcome":"completed","paths":[{"baseline":{"method":"projection","reason":"path cluster"},"blob":"68a698b7db40bf46f21c67c1a80251915bac00e9","disposition":"included","mode":"100644","path":"apps/crq-python/ops/unit-switch-factory.py","reason":"bounded verified input"}],"policy_digest":"eacd1bcf42a0e72eca72fcf9c1e9c8f97e7c515cd67a8fa7965c966924647693","repo":"camerontaylor/cq-toolkit","requested_scope":[{"blob":"68a698b7db40bf46f21c67c1a80251915bac00e9","intervals":[[39,42]],"path":"apps/crq-python/ops/unit-switch-factory.py"}],"reviewed_scope":[{"blob":"68a698b7db40bf46f21c67c1a80251915bac00e9","intervals":[[39,42]],"path":"apps/crq-python/ops/unit-switch-factory.py"}],"scope_digest":"593fbae32e556f7cd3670ef05fc6608cbee7a2e8310642e5c9022f9d69c086f5","source":{"authenticated":true,"id":"backfill-7fb626e2e5b9b75f6efd0ee887d18b83a98b041c93f8a1ae2d48b9c96beb0c3a-g0-20261115T050119Z","producer":"crq-runner-app","repo":"camerontaylor/cq-toolkit","type":"crq-run"},"subject_id