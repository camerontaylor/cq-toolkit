{"event_type":"finding-event","id":"3c48c2f4a5093872137673a637390c72dd53987e0c18049ea88d4bf7e9649e26","occurred_at":"2026-11-09T01:39:32Z","payload":{"action":"confirmed","actor":"crq-triage/opencode-go/deepseek-v4.1-flash","evidence":{"anchor_recovered_from":"ab0b1ec74a7c6f7bd3050b2dd9745f7ddffbef6c5a3d923db4b9c6395a94187e","anchor_verified":true,"mapped_intervals":[[18,18]],"mapped_path":"scripts/lib/build-env.mjs","quoted_text":"const URL_WITH_PASSWORD = /[a-z][a-z0-9+.-]*:\\/\\/[^\\s/@:]*:[^\\s/@]+@/i;","reason":"The scrubber is documented as removing every credential-bearing variable, but URL_WITH_PASSWORD only matches userinfo containing a colon. A value such as DEPLOY_URL=https://<token>@example.invalid/ matches neither the name filters nor the URL regex, so it reaches the build child. A bearer token can be placed in the username-only userinfo position, so this is an implementation gap in the intended credential scrubbing, not merely a request for a new protection scope.","recovered_anchor":{"anchor_recovered_from":"ab0b1ec74a7c6f7bd3050b2dd9745f7ddffbef6c5a3d923db4b9c6395a94187e","blob":"b5fa5894dd5a9134ffa9b6bbfcda513f56542914","intervals":[[18,18]],"path":"scripts/lib/build-env.mjs"},"target":"43cc6aa7c3ddc5e79dc8e9f65d529ec70831d9d8"},"finding_id":"188440a527b4e7485fb6a8410d03a65c1fc86f83c8efec2e341cdb9570f05206","previous_event_id":null,"review_id":"8b154a0c5a503f8c1cc7b23867b73f2b143164840e7f1443b40192388aa71b2d"},"schema":"cq.review-ledger/v1","source_key":"finding:188440a527b4e7485fb6a8410d03a65c1fc86f83c8efec2e341cdb9570f05206:c8626214558db0dadd5180f50affec085b5677c321e3180441bf98adf20e90a1"}