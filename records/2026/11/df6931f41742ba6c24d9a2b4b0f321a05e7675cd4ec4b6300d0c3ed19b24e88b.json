ected during candidate preparation rather than preflight.\n\n<details>\n<summary>Proposed change</summary>\n\n```diff\n-  const prepareDependencies = async (cwd: string, finding: Finding, admit: () => void) => {\n+  const prepareDependencies = async (\n+    cwd: string,\n+    finding: Finding,\n+    admit: () => void,\n+    snapshot = true,\n+  ) => {\n     try {\n       const dependencies = await dependencyDirectory(admit, cwd);\n-      if (dependencies)\n+      if (dependencies && snapshot)\n         await snapshotAddressDependencies(dependencies, resolve(cwd, 'node_modules'), admit);\n       return dependencies;\n@@\n-    const dependencies = await prepareDependencies(cwd, finding, admit);\n+    const cached = baselineCache.get(parent);\n+    const dependencies = await prepareDependencies(\n+      cwd,\n+      finding,\n+      admit,\n+      cached === undefined || includeFinding,\n+    );\n     try {\n-      let leg = baselineCache.get(parent);\n+      let leg = cached;\n```\n\n</details>","id":"c3f1668343fba8faf4e214415a826e1ed4e733be20411632573ca9843e45e321","intervals":[],"path":"src/ops/review/addressWorker.ts","severity":"minor","source_id":null,"status":"untriaged","title":"Skip the dependency snapshot on a preflight cache hit."}],"head":"34591728f798ca0ad85b3301602f66f5c64cd3cf","head_tree":"cc75c7885aeaf67b986983f1d5626715530dd317","input_scope":[{"blob":"3a18693df6384586c47d4e25f1a730ac30ec683c","intervals":[[1,7],[10,15],[22,22],[27,32],[72,85],[103,104],[114,116],[124,124],[126,127],[145,146],[158,189],[254,254],[361,361],[371,371],[382,385],[387,392],[407,407],[463,463],[501,506],[529,535],[538,649],[651,678],[696,770],[773,774],[819,820],[830,842],[856,857],[914,920],[927,927],[937,966],[1031,1050],[1091,1092],[1094,1102],[1146,1149],[1194,1196],[1244,1250],[1265,1272],[1274,1276],[1281,1284],[1295,1295],[1302,1304]],"path":"src/ops/review/addressWorker.ts"},{"blob":"4c462abbffbf517e9f178e193f721ca2fc25fd01","intervals":[[2,2],[7,9],[11,16],[41,41],