an miss an abort during that gap. Pass the signal to `spawn` and use the remaining budget for the timer.\n\n<details>\n<summary>Suggested fix</summary>\n\n```diff\n-  return (request) =>\n+  return (request, options) =>\n     new Promise((resolve, reject) => {\n+      const signal = options?.signal;\n+      signal?.throwIfAborted();\n       if (Buffer.byteLength(request) > QUEUE_WIRE_BYTES) {\n         reject(new Error('oversized queue request'));\n         return;\n@@\n-        { stdio: ['pipe', 'pipe', 'pipe'] },\n+        { stdio: ['pipe', 'pipe', 'pipe'], signal, killSignal: 'SIGKILL' },\n       );\n       const chunks: Buffer[] = [];\n       let size = 0;\n+      const remaining = options?.remainingMs?.();\n+      const limit =\n+        remaining === undefined\n+          ? 45000\n+          : Math.max(1, Math.min(45000, Number.isFinite(remaining) ? remaining : 0));\n       const timer = setTimeout(() => {\n         child.kill('SIGKILL');\n         reject(new Error('queue delivery unknown: timeout'));\n-      }, 45000);\n+      }, limit);\n@@\n       child.on('error', () => {\n         clearTimeout(timer);\n-        reject(new Error('queue transport unavailable'));\n+        reject(signal?.aborted ? signal.reason : new Error('queue transport unavailable'));\n       });\n```\n\n</details>","id":"c48cdf9fedd1e0f70d7c9e9af6b760e8bed8fd1c797c92122102fdfa9a96f9be","intervals":[],"path":"src/ops/review/internal/queueClient.ts","severity":"minor","source_id":null,"status":"untriaged","title":"Bound the SSH child by the caller lifetime (`src/ops/review/internal/queueClient.ts:90-151`)."}],"head":"026424294768cb89b74c7e7cfe99249df5a9bbbf","head_tree":"74119e2e60617e97b4070712a18195b8b48c1179","input_scope":[{"blob":"d1dfda6100cb662215eb6ea8e735318eb605ded0","intervals":[[1,1],[23,23],[37,37],[43,43],[45,49],[51,61],[71,83],[89,91],[101,102],[106,107],[116,120],[128,128],[144,156],[162,163],[170,174],[178,180],[194,197],[246,252],[258,261],[293,293],[305,316],[319,341],