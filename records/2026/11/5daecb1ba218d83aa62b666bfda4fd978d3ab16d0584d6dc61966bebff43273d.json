e/sweep/sweep.e2e.helpers.ts:230`. Strip these names in both runners. Explicit `env` values are merged after the strip, so the existing config isolation is kept.\n\n<details>\n<summary>Suggested fix</summary>\n\n```diff\n-    git: makeGhRunner({ bin: 'git', timeoutMs: 30_000 }),\n+    git: makeGhRunner({\n+      bin: 'git',\n+      timeoutMs: 30_000,\n+      unsetEnv: ['GIT_DIR', 'GIT_WORK_TREE', 'GIT_INDEX_FILE'],\n+    }),\n```\n\n</details>","id":"78c8226c4af423289b608073487e79d61fbe810f4b5cdef72abaf5999dc59be6","intervals":[[255,255]],"path":"test/e2e/sweep/sweep.e2e.test.ts","severity":"minor","source_id":null,"status":"untriaged","title":"Strip inherited Git repository selectors from the focused runners."}],"head":"3fde3f7a5105c96ea4e149a21701018bda37d61f","head_tree":"013c2fa4bf520f2358e9d1367a3d73c21ab4fb44","input_scope":[{"blob":"00f8dda525bd7770718dae6a16273e3919f07c7d","intervals":[[16,19],[21,22],[43,44],[53,54],[57,57],[59,63],[65,68],[107,117],[135,136],[183,183],[195,198],[205,205],[207,207],[236,258],[357,361],[363,379],[421,423],[444,452],[512,525],[537,538],[753,776],[778,778],[782,782],[784,791],[812,812],[843,843],[924,939],[941,966],[973,973],[976,1077],[1083,1084],[1086,1087],[1091,1092],[1095,1095],[1097,1097],[1103,1110],[1114,1114],[1130,1130],[1140,1140],[1204,1204],[1245,1301],[1327,1328],[1340,1342],[1391,1413]],"path":"test/e2e/sweep/sweep.e2e.test.ts"},{"blob":"965b883bb958a4aee07e2343e627310ad46a4363","intervals":[[23,23],[124,124]],"path":"test/fixtures/scratch-repo/generate.ts"},{"blob":"ff4893a3183a6a6cf94441585d087f169bb140c6","intervals":[[1,23]],"path":"test/helpers/git-env.ts"},{"blob":"4b9d221241a307459152dcba61b1bab4c4620238","intervals":[[1,105]],"path":"test/helpers/git-template.test.ts"},{"blob":"fb57425833164ea35b229a4ce2a677fcd6ded106","intervals":[[1,180]],"path":"test/helpers/git-template.ts"},{"blob":"890ce97e4f60357e8db6f3e509a2d6d756f90ebf","intervals":[[20,20],[22,22],[24,24],[46,46],[111,117],[142,144],[294,296],[