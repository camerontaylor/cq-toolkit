`agent-local-state` can also be skipped for that renamed file.\n\nAdd `--no-renames` to `DIFF_OPTS` in the template, then re-instantiate the workflow. Do not edit `.github/workflows/denylist.yml` directly.\n\n<details>\n<summary>Suggested fix (policy/templates/denylist.yml:104)</summary>\n\n```diff\n-          DIFF_OPTS=\"--text --no-textconv --no-ext-diff\"\n+          DIFF_OPTS=\"--text --no-textconv --no-ext-diff --no-renames\"\n```\n\n</details>","id":"c5c21390f2dd6dc4251ebb03d377d4d92c48d6435ad521dccb604cc691a72de3","intervals":[[105,105]],"path":".github/workflows/denylist.yml","severity":"major","source_id":null,"status":"untriaged","title":"Disable rename detection in the denylist diff scan."}],"head":"aef98d631f24c88e58881bbd6d90c0eabbb75bc4","head_tree":"0d65d4810f33ebd3f59ceadb6cd04b9dbafa38fc","input_scope":[{"blob":"e61ec847a549eec553079a41086d23976c4679f2","intervals":[[1,121]],"path":".github/workflows/denylist.yml"}],"job_id":"797f17196f12be9144fcac523c6d831364a9a07be67516d3956fafea6f16045b:0","outcome":"completed","paths":[{"baseline":{"method":"projection","reason":"path cluster"},"blob":"e61ec847a549eec553079a41086d23976c4679f2","disposition":"included","mode":"100644","path":".github/workflows/denylist.yml","reason":"bounded verified input"}],"policy_digest":"eacd1bcf42a0e72eca72fcf9c1e9c8f97e7c515cd67a8fa7965c966924647693","repo":"camerontaylor/cq-toolkit","requested_scope":[{"blob":"e61ec847a549eec553079a41086d23976c4679f2","intervals":[[106,110],[113,113],[121,121]],"path":".github/workflows/denylist.yml"}],"reviewed_scope":[{"blob":"e61ec847a549eec553079a41086d23976c4679f2","intervals":[[106,110],[113,113],[121,121]],"path":".github/workflows/denylist.yml"}],"scope_digest":"b7c901996749e6ed52121cff4bd37736866bde021fc839326694ff50af53c080","source":{"authenticated":true,"id":"backfill-797f17196f12be9144fcac523c6d831364a9a07be67516d3956fafea6f16045b-g0-20261120T222130Z","producer":"crq-runner-app","repo":"camerontaylor/cq-toolkit","type":"crq-r