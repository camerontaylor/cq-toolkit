.omc`/`.omx` paths, and `GH_FOR_FA`. Either add gitleaks rules that cover these classes, or restore a pattern-based scan of the unpacked package. Any new rule must also be checked against the repository-tree scan in step 60, which uses the same configuration.","id":"7caacd3886966d3fd48f1258fc9becc7899a9f79a7c286c34b5b601cc3d692ee","intervals":[[81,81]],"path":"docs/0.2-release-runbook.md","severity":"major","source_id":null,"status":"untriaged","title":"The package scan does not enforce the denylist patterns."}],"head":"24b6dd8441351eefdbec74a0c1ea2543c1e0cfec","head_tree":"067d49da10942551a3c39da201ad1d79467f9afa","input_scope":[{"blob":"aa55d90900b483dad38bd12c4b8a3ad2eb057fed","intervals":[[14,15],[19,25],[60,60],[81,81],[99,108],[153,155],[177,178]],"path":"docs/0.2-release-runbook.md"}],"job_id":"5a9f466722dd908984cb2a25d66d73aaf483484f84d5d375b4adaff1b8ae01ab:0","outcome":"completed","paths":[{"baseline":{"entry":{"blob":"47660464df092709fee93c34046e23a486c454ac","kind":"blob","mode":"100644","path":"docs/0.2-release-runbook.md"},"merge":"920e147b324cb85fc5b695243a96dfec1706ec86","method":"pre-merge","pre":"77a4c5b9c41892e82d6404383e262ae3281e7638","source_path":"docs/0.2-release-runbook.md"},"blob":"aa55d90900b483dad38bd12c4b8a3ad2eb057fed","disposition":"included","mode":"100644","path":"docs/0.2-release-runbook.md","reason":"bounded verified input"}],"policy_digest":"eacd1bcf42a0e72eca72fcf9c1e9c8f97e7c515cd67a8fa7965c966924647693","repo":"camerontaylor/cq-toolkit","requested_scope":[{"blob":"aa55d90900b483dad38bd12c4b8a3ad2eb057fed","intervals":[[177,178]],"path":"docs/0.2-release-runbook.md"}],"reviewed_scope":[{"blob":"aa55d90900b483dad38bd12c4b8a3ad2eb057fed","intervals":[[177,178]],"path":"docs/0.2-release-runbook.md"}],"scope_digest":"56c99952a7a2b4eaafc694e3776c70060f73cda5bf8b77878470db1a787a47fc","source":{"authenticated":true,"id":"backfill-5a9f466722dd908984cb2a25d66d73aaf483484f84d5d375b4adaff1b8ae01ab-g0-20261117T151756Z","producer":"crq-runner