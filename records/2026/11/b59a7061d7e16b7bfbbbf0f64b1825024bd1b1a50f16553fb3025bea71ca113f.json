lso cannot match on that host, so it passes without testing anything.\n\nOn POSIX hosts `sep` is `/`, so the current assertions match.\n\nBuild the expected values from `sep`:\n\n<details>\n<summary>Suggested fix</summary>\n\n```diff\n       seen.push(candidate);\n-      return candidate === '/trusted/gh.exe';\n+      return candidate === `/trusted${sep}gh.exe`;\n     },\n   );\n-  expect(result).toBe('/trusted/gh.exe');\n-  expect(seen.every((candidate) => !candidate.startsWith('/caller/'))).toBe(true);\n+  expect(result).toBe(`/trusted${sep}gh.exe`);\n+  expect(seen.every((candidate) => !candidate.startsWith(`/caller${sep}`))).toBe(true);\n```\n\n</details>\n\nIf the test file does not already import `sep`, add it to its `node:path` import.","id":"3568ed954cb2ec0d30a56ffa1c0d2ac2ee339ee6a10a54068fdfba070eb529ad","intervals":[[202,202]],"path":"test/ops/review/gh.test.ts","severity":"minor","source_id":null,"status":"untriaged","title":"Build the expected Windows candidate with the host separator."}],"head":"ccedffbec653c21331a783ad407fa5c47731fd64","head_tree":"26c3b0934808252bdcdb6b4602387f222cc522cf","input_scope":[{"blob":"4737d6c842f4832e97f2e312b0809a2fe227bbf9","intervals":[[1,277]],"path":"test/ops/review/gh.test.ts"}],"job_id":"403c990be69d446d4d3d13f489aa72df0d566c31072424eb72138e4cbf8ed361:0","outcome":"completed","paths":[{"baseline":{"entry":null,"merge":"5c07c6600754c26eca20d2eb2c6770a8bfb41103","method":"pre-merge","pre":"97ab1796bc8a323f48e1a660b665eb239ec5cffc","source_path":"test/ops/review/gh.test.ts"},"blob":"4737d6c842f4832e97f2e312b0809a2fe227bbf9","disposition":"included","mode":"100644","path":"test/ops/review/gh.test.ts","reason":"bounded verified input"}],"policy_digest":"eacd1bcf42a0e72eca72fcf9c1e9c8f97e7c515cd67a8fa7965c966924647693","repo":"camerontaylor/cq-toolkit","requested_scope":[{"blob":"4737d6c842f4832e97f2e312b0809a2fe227bbf9","intervals":[[10,10],[12,12],[16,21],[110,241]],"path":"test/ops/review/gh.test.ts"}],"reviewed_scope"