re not stored, so the replay cannot show the earlier rejection.\n\nApply the same receipt check on replay before returning a completed status:\n\n<details>\n<summary>Suggested fix</summary>\n\n```diff\n         else:\n             binding = q[\"review_requests\"][req[\"request_id\"]]\n+            item = next(i for i in q[\"items\"] if i[\"id\"] == binding[\"item\"])\n+            if result.get(\"receipt_id\") and not retained(runner, item):\n+                result.update(next_action=\"resubmit\", reason=\"receipt-unavailable\")\n             result[\"history\"] = history_cue(history_projection(\n```\n\n</details>","id":"f053a66568c5eb88b8faa26992a3641f595b0fea70740a0b1a7f97abbef9fe7d","intervals":[[56,57]],"path":"apps/crq-python/review_admission.py","severity":"major","source_id":null,"status":"untriaged","title":"Apply the receipt check to replayed admission responses."}],"head":"a94a7326bcf8f82306ba887d4947265f14e1c9f1","head_tree":"ff441c47f135816927d2c105b0555b66502df3d8","input_scope":[{"blob":"806a68f7fe359962a9509ff72dbeadc37500c8c5","intervals":[[1,66]],"path":"apps/crq-python/crq_review_identity.py"},{"blob":"3a1fc4ef29a418657c7c5faa1ac6793663a1ad85","intervals":[[1,131]],"path":"apps/crq-python/review_admission.py"},{"blob":"68fe3d40b47bf4b18485732aedbff0ba6b582061","intervals":[[1,432]],"path":"apps/crq-python/test_crq_fixtures.py"},{"blob":"6eff6e7fbb82ff6dfdfe59d5cba2152e666282bf","intervals":[[1,81]],"path":"apps/crq-python/test_crq_review_identity.py"},{"blob":"73823629a650fe39fadad001b63f0431403c251a","intervals":[[1,206]],"path":"apps/crq-python/test_ledger_vector_emit_b1.py"},{"blob":"9ab1953a7c3919da7b990290bfe3413e614cd3d5","intervals":[[1,433]],"path":"apps/crq-python/test_package_runner.py"},{"blob":"7446f44790e40eb9eaef5cac8c096b96dc1500a5","intervals":[[1,278]],"path":"apps/crq-python/test_push_current_fixtures.py"},{"blob":"29feb844bf415c674030fd327222de5c080b29ce","intervals":[[1,526]],"path":"apps/crq-python/test_unit_switch_factory.py"