e spend.”","id":"2b5c3e86be2af944bf207a254f4a502538de68c21038212b211198bcd7615bb7","intervals":[],"path":"src/driver/README.md","severity":"minor","source_id":null,"status":"untriaged","title":"Include the cancellation option in the signature."},{"anchor_status":"unverified","blob":"1e937e8e5e3e312d4d77a1dd88a7e93c86911564","body":"**Assign modeled cost calculation to drivers.**\n\nThis says callers compute `costUSD`, but `src/driver/README.md:248` describes driver-side pricing. The path instruction also assigns the lookup to each driver and says the kernel only observes the result. Correct the seam rule so driver implementers do not omit cost reporting.\n\nAs per path instructions, “each driver attaches an optional derived costUSD” and “The kernel only observes costUSD.”","id":"960b425802cfab5e5b985f8940e0fe3ff0da4a2e7e1e94b9dc56486d59dbfe2e","intervals":[],"path":"src/driver/README.md","severity":"minor","source_id":null,"status":"untriaged","title":"Assign modeled cost calculation to drivers."}],"head":"754824eb841fe4d580cf03501d524369fea676c3","head_tree":"caf2bd1c0f6a76b490442f34307539ee3268e814","input_scope":[{"blob":"1e937e8e5e3e312d4d77a1dd88a7e93c86911564","intervals":[[1,558]],"path":"src/driver/README.md"}],"job_id":"7b7d97115f035d65d11017c331a4be889db8d1aa42ed023d38e378a65a6dc52f:0","outcome":"completed","paths":[{"baseline":{"method":"projection","reason":"residual uncovered lines"},"blob":"1e937e8e5e3e312d4d77a1dd88a7e93c86911564","disposition":"included","mode":"100644","path":"src/driver/README.md","reason":"bounded verified input"}],"policy_digest":"eacd1bcf42a0e72eca72fcf9c1e9c8f97e7c515cd67a8fa7965c966924647693","repo":"camerontaylor/cq-toolkit","requested_scope":[{"blob":"1e937e8e5e3e312d4d77a1dd88a7e93c86911564","intervals":[[361,361],[379,379]],"path":"src/driver/README.md"}],"reviewed_scope":[{"blob":"1e937e8e5e3e312d4d77a1dd88a7e93c86911564","intervals":[[361,361],[379,379]],"path":"src/driver/README.md"}],"scope_digest":"2e3a39c73937b4a6ba4