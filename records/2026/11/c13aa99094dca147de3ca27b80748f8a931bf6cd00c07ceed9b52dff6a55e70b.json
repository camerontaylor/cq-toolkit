ry>\n\n```diff\n import contextlib\n import importlib.util\n import io\n import json\n+import os\n import pathlib\n import tempfile\n import unittest\n```\n\n```diff\n         base = pathlib.Path(self.temp.name)\n+        xdg_state = mock.patch.dict(os.environ,\n+                                    {\"XDG_STATE_HOME\": str(base / \"xdg-state\")})\n+        xdg_state.start()\n+        self.addCleanup(xdg_state.stop)\n         self.root = base / \"checkout\"\n```\n\n</details>","id":"0adec338ad29fae9d41881a1877ff2f2f6b31fdeb145536033fae43b8fbc9661","intervals":[[102,102]],"path":"apps/crq-python/test_unit_switch_cli.py","severity":"minor","source_id":null,"status":"untriaged","title":"Set `XDGSTATEHOME` to a temporary directory in the CLI test fixture."}],"head":"aa9f35954dc4caf57d8afd805bc45fe788df2ae3","head_tree":"7e3bc6040d8da1acb2564424b853efe795537180","input_scope":[{"blob":"a06a706928b2fcaedc75a9b2f1731d9cd2b72e8c","intervals":[[1,372]],"path":"apps/crq-python/repair_request_vectors.py"},{"blob":"b7f89b884422d424b850a3f4f73c1e77c2ac66b4","intervals":[[1,99]],"path":"apps/crq-python/test_host_config_prepare.py"},{"blob":"69c0ffeaca8e7b38085f88a07e979d29e4cc8be0","intervals":[[1,1283]],"path":"apps/crq-python/test_unit_adapter.py"},{"blob":"9b8ef57959b5e5652096fad1b31b265d45175d96","intervals":[[1,295]],"path":"apps/crq-python/test_unit_switch_cli.py"}],"job_id":"cc34fd2482c791cc7e625410695b53d395a81e5dd025dbfa608e4643cd8d952b:0","outcome":"completed","paths":[{"baseline":{"method":"projection","reason":"path cluster"},"blob":"a06a706928b2fcaedc75a9b2f1731d9cd2b72e8c","disposition":"included","mode":"100644","path":"apps/crq-python/repair_request_vectors.py","reason":"bounded verified input"},{"baseline":{"method":"projection","reason":"path cluster"},"blob":"b7f89b884422d424b850a3f4f73c1e77c2ac66b4","disposition":"included","mode":"100644","path":"apps/crq-python/test_host_config_prepare.py","reason":"bounded verified input"},{"baseline":{"method":"projection",