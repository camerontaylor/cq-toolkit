{"event_type":"review","id":"74f3b2743d914a41014bebe0d58ff07c94d5d546eb3a2a9209b30817b024c9c9","occurred_at":"2026-11-05T12:55:16Z","payload":{"artifacts":[{"location":"/home/ctaylor/.local/share/crq-backfill/artifacts/sha256/f607241b11ab02f6989fe853aea7b36ace3eed6346a6074edcb6651d6dd4e0d0","sha256":"f607241b11ab02f6989fe853aea7b36ace3eed6346a6074edcb6651d6dd4e0d0"},{"location":"/home/ctaylor/.local/share/crq-backfill/artifacts/sha256/e0f5d783b4c8b647a987087128b664fe814aa919ad18f4c4ec0cd12209ba284e","sha256":"e0f5d783b4c8b647a987087128b664fe814aa919ad18f4c4ec0cd12209ba284e"},{"kind":"git-bundle","location":"/home/ctaylor/.local/share/crq-backfill/artifacts/sha256/6a8095c91132eefb9755992cac21d41f7cabe2a90d049d5861c8e2833cf27f73","sha256":"6a8095c91132eefb9755992cac21d41f7cabe2a90d049d5861c8e2833cf27f73"},{"location":"/home/ctaylor/.local/share/crq-backfill/artifacts/sha256/12e9faaf24d21c5d2cc0a8347deebaa8172f636dad8e7845005550a301be7ca4","sha256":"12e9faaf24d21c5d2cc0a8347deebaa8172f636dad8e7845005550a301be7ca4"},{"location":"/home/ctaylor/.local/share/crq-backfill/artifacts/sha256/decf37c204993ab1ef1881596b8cf2c4e76fdcf42a6b1f317be635ece5af0740","sha256":"decf37c204993ab1ef1881596b8cf2c4e76fdcf42a6b1f317be635ece5af0740"}],"attempt_id":"185ccecf22c5757a9d9216496d80bf5e0ddc80443375c751b15fcf59141981cf:0:1","base":"ab509b66db9afe5957eb26c067a7341f29017a83","completion":{"errors":[],"exit_code":0,"scope_verified":true,"skipped":false,"terminal":true},"findings":[{"anchor_status":"unverified","blob":"a6e23400fb0d969ff788f972881abf352aa4306b","body":"**Treat an empty reported driver as `unknown`.**\n\n`validSessionLink` keeps `driver: ''` at `src/kernel/runner.ts:322`. It checks only `typeof`, while its doc comment says it keeps \"non-empty strings only.\" The empty value then reaches the journal in two ways:\n\n- A reported link for a session that has no result-derived link keeps `driver: ''` in `job-finished.sessions`.\n- In `mergeSessionLinks`, a reported `''` replaces a result-derived `'unknown'` driver, because only `'unknown'` is overwritten.\n\nThe journal schema does not reject this value. `z.string()` accepts an empty string, so the malformed link persists rather than being dropped.\n\n<details>\n<summary>Proposed fix</summary>\n\n```diff\n-    driver: typeof raw['driver'] === 'string' ? raw['driver'] : 'unknown',\n+    driver: nonEmpty(raw['driver']) ? raw['driver'] : 'unknown',\n```\n\n</details>","id":"a4446a959e9c7ea5c469c2a147f8ec7b21444418234ba560d56d8f80f61fa0d3","intervals":[],"path":"src/kernel/runner.ts","severity":"minor","source_id":null,"status":"untriaged","title":"Treat an empty reported driver as `unknown`."}],"head":"b3d4efaa13abbb31a1450c2665d24a3f2a0a732d","head_tree":"74119e2e60617e97b4070712a18195b8b48c1179","input_scope":[{"blob":"a6e23400fb0d969ff788f972881abf352aa4306b","intervals":[[7,7],[148,148],[171,174],[178,178],[220,225],[228,228],[284,354],[430,430],[1065,1075],[1271,1286],[1294,1298],[1488,1488],[1502,1516],[1529,1533],[1694,1700],[1709,1711],[1774,1779]],"path":"src/kernel/runner.ts"},{"blob":"f75825c5439b5c0a037b368395a4c98e5eb6b534","intervals":[[12,12],[25,27],[55,59],[87,87],[104,104],[109,109],[143,143],[170,191],[205,206],[366,367],[404,405],[415,419],[421,422],[439,439],[683,691],[694,696],[713,713],[752,758],[793,805]],"path":"src/ops/review/fixReviewItem.ts"}],"job_id":"185ccecf22c5757a9d9216496d80bf5e0ddc80443375c751b15fcf59141981cf:0","outcome":"completed","paths":[{"baseline":{"entry":{"blob":"d6e5341bdc45b700b181212402928277fcae4003","kind":"blob","mode":"100644","path":"src/kernel/runner.ts"},"merge":"4d76b62252c2053a7506be0f9296087bc0fad89b","method":"pre-merge","pre":"662375e4d1164bfa4ebedc575f1c6d5cc515ef0a","source_path":"src/kernel/runner.ts"},"blob":"a6e23400fb0d969ff788f972881abf352aa4306b","disposition":"included","mode":"100644","path":"src/kernel/runner.ts","reason":"bounded verified input"},{"baseline":{"entry":{"blob":"61e04464d0fdd9742d42448ac05ce65f41c2e1a8","kin