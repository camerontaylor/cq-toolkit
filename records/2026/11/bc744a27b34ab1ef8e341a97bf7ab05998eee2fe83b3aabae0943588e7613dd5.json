{"event_type":"review","id":"bc744a27b34ab1ef8e341a97bf7ab05998eee2fe83b3aabae0943588e7613dd5","occurred_at":"2026-11-09T00:56:23Z","payload":{"artifacts":[{"location":"/home/ctaylor/.local/share/crq-backfill/artifacts/sha256/174522cf1695b4e845904160314d024c00f157a22549e2f9d427baad40bb8b50","sha256":"174522cf1695b4e845904160314d024c00f157a22549e2f9d427baad40bb8b50"},{"location":"/home/ctaylor/.local/share/crq-backfill/artifacts/sha256/78b7457e53ed0c96b98c69088a2b047839a8343b059a491a5d02893997e78f3c","sha256":"78b7457e53ed0c96b98c69088a2b047839a8343b059a491a5d02893997e78f3c"},{"kind":"git-bundle","location":"/home/ctaylor/.local/share/crq-backfill/artifacts/sha256/8459fdf653f2595e76e9dc7abf6fa0a21731d3187db6dd59580e1cce778f6821","sha256":"8459fdf653f2595e76e9dc7abf6fa0a21731d3187db6dd59580e1cce778f6821"},{"location":"/home/ctaylor/.local/share/crq-backfill/artifacts/sha256/2006631fd90386ad57a13da96bb0e95d248ed8a416703036af2b900b017f72e6","sha256":"2006631fd90386ad57a13da96bb0e95d248ed8a416703036af2b900b017f72e6"},{"location":"/home/ctaylor/.local/share/crq-backfill/artifacts/sha256/6cb83b8fed79c8c01c0f7263013e88604a503a64513e4e02064b1bc667ceb39e","sha256":"6cb83b8fed79c8c01c0f7263013e88604a503a64513e4e02064b1bc667ceb39e"}],"attempt_id":"bd5ce2f8ec581fa89694213241abf7c1eefa7e46859ff6e6ea2000bae6c90923:0:1","base":"7a1a06db031aa65dfe6fd1dd1a15fe60eec18736","completion":{"errors":[],"exit_code":0,"scope_verified":true,"skipped":false,"terminal":true},"findings":[{"anchor_status":"verified","blob":"34dcf8099b4afc9729774070a6cd129e3229c04e","body":"**`.resolve()` disables the record-directory symlink check.**\n\n`args.record_dir.resolve()` follows symlinks before `Effects` stores the path. Because of that, `record_preflight`'s `self.record_dir.is_symlink()` check (Line 232) can never be true for a symlinked `--record-dir`. Journals are then written to the symlink target, and the check never refuses. Make the path absolute without following symlinks.\n\n<details>\n<summary>Proposed fix</summary>\n\n```diff\n-    effects = Effects(root, args.record_dir.resolve())\n+    effects = Effects(root, Path(os.path.abspath(args.record_dir)))\n```\n</details>","id":"0e7a2aa204884cc941f8e64f0391448b114ca2089de5f452ab90ee268de5a8a8","intervals":[[1442,1442]],"path":"apps/crq-python/ops/deploy-controller.py","severity":"minor","source_id":null,"status":"untriaged","title":"`.resolve()` disables the record-directory symlink check."}],"head":"0c276e995af29c8f74783a23352ac7d21811e990","head_tree":"df3263d3bcbdb1bef920209c9d76e07c2e9ce437","input_scope":[{"blob":"34dcf8099b4afc9729774070a6cd129e3229c04e","intervals":[[1,1509]],"path":"apps/crq-python/ops/deploy-controller.py"}],"job_id":"bd5ce2f8ec581fa89694213241abf7c1eefa7e46859ff6e6ea2000bae6c90923:0","outcome":"completed","paths":[{"baseline":{"method":"projection","reason":"path cluster"},"blob":"34dcf8099b4afc9729774070a6cd129e3229c04e","disposition":"included","mode":"100644","path":"apps/crq-python/ops/deploy-controller.py","reason":"bounded verified input"}],"policy_digest":"eacd1bcf42a0e72eca72fcf9c1e9c8f97e7c515cd67a8fa7965c966924647693","repo":"camerontaylor/cq-toolkit","requested_scope":[{"blob":"34dcf8099b4afc9729774070a6cd129e3229c04e","intervals":[[556,569],[694,695],[697,823],[827,827],[829,837],[849,853],[869,879],[881,881],[891,891],[941,941],[943,943],[945,951],[954,954],[956,956],[959,1016],[1024,1027],[1033,1033],[1037,1037]],"path":"apps/crq-python/ops/deploy-controller.py"}],"reviewed_scope":[{"blob":"34dcf8099b4afc9729774070a6cd129e3229c04e","intervals":[[556,569],[694,695],[697,823],[827,827],[829,837],[849,853],[869,879],[881,881],[891,891],[941,941],[943,943],[945,951],[954,954],[956,956],[959,1016],[1024,1027],[1033,1033],[1037,1037]],"path":"apps/crq-python/ops/deploy-controller.py"}],"scope_digest":"46a23b8e5016522b00668a903dde858fb6a0c4ff562277180f8c95c08b4c8fca","source":{"authenticated":true,"id":"backfill-bd5ce2f8ec581fa89694213241abf7c1eefa7e46859ff6e6ea2000bae6c9092