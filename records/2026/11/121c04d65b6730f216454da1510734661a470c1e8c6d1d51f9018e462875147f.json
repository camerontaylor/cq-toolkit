_batches.py","reason":"bounded verified input"},{"baseline":{"method":"projection","reason":"path cluster"},"blob":"20fa64aef907b6d292f125b842de0ad596f3901f","disposition":"included","mode":"100644","path":"apps/crq-python/test_repair_context_isolation.py","reason":"bounded verified input"},{"baseline":{"method":"projection","reason":"path cluster"},"blob":"901b760479afbd72a62e68a2506389d2970530e7","disposition":"included","mode":"100644","path":"apps/crq-python/test_review_admission_execution.py","reason":"bounded verified input"},{"baseline":{"method":"projection","reason":"path cluster"},"blob":"f14e12687f57227a7c5c7a1b435e60fc75371247","disposition":"included","mode":"100644","path":"apps/crq-python/test_tick_shadow_compare.py","reason":"bounded verified input"},{"baseline":{"method":"projection","reason":"path cluster"},"blob":"e3ba46143ae5ae86990c4c13564bba86efb5fedb","disposition":"included","mode":"100644","path":"apps/crq-python/tick_shadow_compare.py","reason":"bounded verified input"}],"policy_digest":"eacd1bcf42a0e72eca72fcf9c1e9c8f97e7c515cd67a8fa7965c966924647693","repo":"camerontaylor/cq-toolkit","requested_scope":[{"blob":"aa3db2fc941fc6bfd4ffc01c75b527d9423b71b3","intervals":[[1,46],[48,138]],"path":"apps/crq-python/test_backfill_inventory.py"},{"blob":"1b7889289b1deaf1172973da812bd276ae4dee1f","intervals":[[15,15],[94,197]],"path":"apps/crq-python/test_deploy_controller_rollback_plan.py"},{"blob":"163c5b8f54d162e47fc872e796e3c1fbc44a280e","intervals":[[1,1],[40,40],[74,74],[77,77],[81,86],[88,142]],"path":"apps/crq-python/test_host_config_switch.py"},{"blob":"66fb74aed7373c560a78c572c1df8ad6d1915ce9","intervals":[[1,36],[43,56],[97,167]],"path":"apps/crq-python/test_ledger_batches.py"},{"blob":"20fa64aef907b6d292f125b842de0ad596f3901f","intervals":[[1,24],[26,72],[74,122]],"path":"apps/crq-python/test_repair_context_isolation.py"},{"blob":"901b760479afbd72a62e68a2506389d2970530e7","intervals":[[80,105]],"path":"apps/crq-python/test_review_admission