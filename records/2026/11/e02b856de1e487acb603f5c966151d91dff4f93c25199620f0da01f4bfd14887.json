jobs.","id":"35729dee42c4bd9d1cacad866ce9e6bf76aba69afff8019bf7c619e98e6652e6","intervals":[],"path":"SELF-HOSTING.md","severity":"minor","source_id":null,"status":"untriaged","title":"Correct the interim-credential claim."},{"anchor_status":"unverified","blob":"18d999ecbe792a0349541eaa9c11825491184588","body":"**Point this row to the current automation credential setup.**\n\nThis row directs operators to put `CQ_AUTOMATION_TOKEN` in `cq-automation`. The current setup uses `CQ_AUTOMATION_APP_KEY` in `automation` and mints the token per run, as documented in `docs/adr/README.md:421-458`. Following this row will not arm the automation jobs. Add a reference to N22 beside the row.\n\nBased on learnings: accepted ADR text is preserved as a historical record, with later changes documented in post-acceptance notes.","id":"edbfc9e9cd7a1c51d0662abe9eafaa9bd6c601258bc2415b5a933e79c824fbfc","intervals":[],"path":"docs/adr/0002-annex-b-config.md","severity":"minor","source_id":null,"status":"untriaged","title":"Point this row to the current automation credential setup."},{"anchor_status":"unverified","blob":"18d999ecbe792a0349541eaa9c11825491184588","body":"**Point the secret rule to the `_URL` exception.**\n\n`docs/adr/README.md:384-412` says `_URL` remains in the diagnostic suffix list, but a safe foreign `_URL` can be journalled by value. An operator following this rule can instead expect presence-only journaling. Add a reference to N21 here and in the annex’s note list.\n\nBased on learnings: accepted ADR text is preserved as a historical record, with later changes documented in post-acceptance notes.","id":"ae8e7d81f17c838234e42195251428462af87ed4c4bebda9ed3b6a7cb5d205aa","intervals":[],"path":"docs/adr/0002-annex-b-config.md","severity":"minor","source_id":null,"status":"untriaged","title":"Point the secret rule to the `URL` exception."}],"head":"3c73633d52d2e94ff0032d5f6614bf4553edc636","head_tree":"013c2fa4bf520f2358e9d1367a3d73c21ab4fb44","input_scope":[{"blob":"a29197