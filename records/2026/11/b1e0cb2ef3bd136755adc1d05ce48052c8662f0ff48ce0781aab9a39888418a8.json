"c2b97bc5e857da2f1694686e0b76f0321e043ea4c2848f0eb53ae2f965d4d0d5","intervals":[],"path":"docs/0.2-release-runbook.md","severity":"major","source_id":null,"status":"untriaged","title":"Bind the package scope to the npm registry."},{"anchor_status":"unverified","blob":"28bac081f95f0e8adbcf3296d13180bc5093907d","body":"**Start the MCP child in the consumer prefix.**\n\n`scripts/packed-smoke.mjs:331` inherits the caller’s cwd, contrary to the smoke’s stated isolation. When launched from the checkout, the MCP child starts there. The bin later changes to the manifest workspace.\n\n<details>\n<summary>Proposed fix</summary>\n\n```diff\n-      return mcpRoundTrip(bin, smokeManifest(workspace), timeoutMs);\n+      return mcpRoundTrip(bin, smokeManifest(workspace), timeoutMs, prefix);\n```\n\n```diff\n-function mcpRoundTrip(bin, manifest, timeoutMs) {\n+function mcpRoundTrip(bin, manifest, timeoutMs, prefix) {\n   return new Promise((resolveLeg) => {\n     const child = spawn(bin, [JSON.stringify(manifest)], {\n+      cwd: prefix,\n       stdio: ['pipe', 'pipe', 'pipe'],\n     });\n```\n\n</details>","id":"65771679be15d65a5eeb401ee10e8dc46dd9f998bf20565942886a761763759c","intervals":[],"path":"scripts/packed-smoke.mjs","severity":"minor","source_id":null,"status":"untriaged","title":"Start the MCP child in the consumer prefix."}],"head":"16e33b1d9ecb4477ab885ced5adee3083c822252","head_tree":"013c2fa4bf520f2358e9d1367a3d73c21ab4fb44","input_scope":[{"blob":"12296edf3183ff0ed64f8a192167c12e87d54a85","intervals":[[1,216]],"path":"docs/0.2-release-runbook.md"},{"blob":"28bac081f95f0e8adbcf3296d13180bc5093907d","intervals":[[1,584]],"path":"scripts/packed-smoke.mjs"},{"blob":"04e4fb3c280d69ce670441b4481eacf17833b928","intervals":[[1,604]],"path":"test/scripts/packed-smoke.test.ts"}],"job_id":"d786ffd66b8ed51c10c4bca43671e1908459e7d61234308be5b96cbf30e1a9a5:0","outcome":"completed","paths":[{"baseline":{"method":"projection","reason":"residual uncovered lines"},"blob":"28bac081f95