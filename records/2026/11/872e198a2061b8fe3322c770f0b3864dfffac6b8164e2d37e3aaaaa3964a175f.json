 `terminal` source is overwritten by a `blocked` one, and completion is lost. Make the merge order-independent. For example, prefer `blocked` over `terminal`, because a missing completion is non-passing under I5. Alternatively, keep both sources.","id":"3f9f8f611ab0164a037a3e036ef0cce545be27594f83307d034518b38c2067cf","intervals":[],"path":"src/ops/review/findings.ts","severity":"minor","source_id":null,"status":"untriaged","title":"`merge` silently drops source records that share the same `kind` and `cycleId` (src/ops/review/findings.ts:176-177)."}],"head":"1245d410d3b2e9d108127b0bbf14a19eb23bcc68","head_tree":"013c2fa4bf520f2358e9d1367a3d73c21ab4fb44","input_scope":[{"blob":"21e42b3cce1f7eb2444c65b0f3269d9626e1b05a","intervals":[[1,237]],"path":"src/ops/review/findings.ts"}],"job_id":"f2e5fe4babb2f3fd2daa816d05c52df0a4558c6cfee5a44778b7af851ca9dd5f:0","outcome":"completed","paths":[{"baseline":{"method":"projection","reason":"residual uncovered lines"},"blob":"21e42b3cce1f7eb2444c65b0f3269d9626e1b05a","disposition":"included","mode":"100644","path":"src/ops/review/findings.ts","reason":"bounded verified input"}],"policy_digest":"3aee477168e1da8e2aa232a98e80747d98da8f26f54f2a27e0c62d13e349d4b1","repo":"camerontaylor/cq-toolkit","requested_scope":[{"blob":"21e42b3cce1f7eb2444c65b0f3269d9626e1b05a","intervals":[[1,237]],"path":"src/ops/review/findings.ts"}],"reviewed_scope":[{"blob":"21e42b3cce1f7eb2444c65b0f3269d9626e1b05a","intervals":[[1,237]],"path":"src/ops/review/findings.ts"}],"scope_digest":"87f70c030c8095ed75a43eba8db917f5257f4d81924150b237a379ca736340f3","source":{"authenticated":true,"id":"backfill-f2e5fe4babb2f3fd2daa816d05c52df0a4558c6cfee5a44778b7af851ca9dd5f-g0-20261107T113520Z","producer":"crq-runner-app","repo":"camerontaylor/cq-toolkit","type":"crq-run"},"subject_id":"f2e5fe4babb2f3fd2daa816d05c52df0a4558c6cfee5a44778b7af851ca9dd5f","target":"c41daab7b343461745140a75c48c4cc59db2a241","target_tree":"013c2fa4bf520f2358e9d1367a3d73c21ab4fb44"},"schema"