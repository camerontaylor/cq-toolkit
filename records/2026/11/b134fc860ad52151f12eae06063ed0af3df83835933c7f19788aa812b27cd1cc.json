ions, review-family entries require “.strict() zod schemas.”    \n<details>\n<summary>Proposed change</summary>\n\n```diff\n-      .array(z.object({ number: z.number().int().positive(), request: QueueEnqueueInputSchema }))\n+      .array(z.object({ number: z.number().int().positive(), request: QueueEnqueueInputSchema }).strict())\n```\n</details>","id":"9dd8b9b71660d35c469180ede6e033f1e1846abb6204e19e6d87155d26c2587d","intervals":[],"path":"src/ops/review/registry.ts","severity":"minor","source_id":null,"status":"untriaged","title":"Make each enrollment row strict."}],"head":"ba96ea58911709ab6406562c9f04bf2b89f11719","head_tree":"a044c2d307ae73d8952cea17b0d4c6811610cdec","input_scope":[{"blob":"5e013192b9430bd1ae79065149b9f106e89b26af","intervals":[[7,7],[148,148],[171,174],[178,178],[220,225],[228,228],[284,354],[430,430],[733,735],[737,738],[742,743],[746,751],[757,757],[760,760],[779,779],[1072,1082],[1278,1293],[1301,1305],[1495,1495],[1509,1523],[1536,1540],[1701,1707],[1716,1718],[1781,1786]],"path":"src/kernel/runner.ts"},{"blob":"e366f9abedc8b580d5efa443d1e6f220f57ce3e7","intervals":[[37,37],[42,42],[45,45],[119,127],[179,181],[202,203],[260,260],[299,323],[342,342],[382,383],[399,399],[407,407],[416,419],[433,433],[436,436],[507,515],[526,526],[528,528],[558,558],[577,577]],"path":"src/ops/gates/hackDetector.ts"},{"blob":"25344bb13739465d31bcf83c5256aa5b2a09fb36","intervals":[[1,3],[63,63],[66,66],[72,82],[409,428],[486,486],[489,493],[538,592],[594,657],[672,675]],"path":"src/ops/review/registry.ts"}],"job_id":"05a21e122f9a54998a0ec433d37cbeae4f6523f1edd7b3b3014367992059c999:0","outcome":"completed","paths":[{"baseline":{"entry":{"blob":"d6e5341bdc45b700b181212402928277fcae4003","kind":"blob","mode":"100644","path":"src/kernel/runner.ts"},"merge":"4d76b62252c2053a7506be0f9296087bc0fad89b","method":"pre-merge","pre":"662375e4d1164bfa4ebedc575f1c6d5cc515ef0a","source_path":"src/kernel/runner.ts"},"blob":"5e013192b9430bd1ae79065149b9f106e89b26af","disposition