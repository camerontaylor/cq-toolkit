 excluded and that no lock, atomic queue generation, or dispatch barrier is claimed. A runner-owned start in that window can overlap installation or activation.\n\nMake the barrier an explicit, required step in the sequence. It must hold from the ownership check through safe release. Until then, list this gap as a blocking prerequisite for any enablement.","id":"9fb727396d40424c12bec85200d287de87843461fc6751456b6f1b8aa8a1fc32","intervals":[[80,81]],"path":"apps/crq-python/ops/UNIT-SWITCH-DESIGN.md","severity":"major","source_id":null,"status":"untriaged","title":"Add a dispatch barrier to the drain sequence."}],"head":"9da1ff4a96440be122db7521220fe58574d45683","head_tree":"e808aac5adf61e3f0f06365372f81340b3333575","input_scope":[{"blob":"480e6fc2180b83efc57cbf820432e6b6c23df880","intervals":[[1,156]],"path":"apps/crq-python/ops/UNIT-SWITCH-DESIGN.md"},{"blob":"38032ca98880faf5789c0d1fd16354480ebcc727","intervals":[[1,582]],"path":"apps/crq-python/ops/VM-UNIT-SWITCH-PROOF.md"}],"job_id":"306e3cfb7a0d93b0024d7880c7655bf58f585dc1ca77ebb1aa9a55542760e32f:0","outcome":"completed","paths":[{"baseline":{"method":"projection","reason":"path cluster"},"blob":"480e6fc2180b83efc57cbf820432e6b6c23df880","disposition":"included","mode":"100644","path":"apps/crq-python/ops/UNIT-SWITCH-DESIGN.md","reason":"bounded verified input"},{"baseline":{"method":"projection","reason":"path cluster"},"blob":"38032ca98880faf5789c0d1fd16354480ebcc727","disposition":"included","mode":"100644","path":"apps/crq-python/ops/VM-UNIT-SWITCH-PROOF.md","reason":"bounded verified input"}],"policy_digest":"eacd1bcf42a0e72eca72fcf9c1e9c8f97e7c515cd67a8fa7965c966924647693","repo":"camerontaylor/cq-toolkit","requested_scope":[{"blob":"480e6fc2180b83efc57cbf820432e6b6c23df880","intervals":[[10,11],[14,17],[19,20],[106,113]],"path":"apps/crq-python/ops/UNIT-SWITCH-DESIGN.md"},{"blob":"38032ca98880faf5789c0d1fd16354480ebcc727","intervals":[[13,19],[28,29],[142,197],[200,345],[504,511],[561,564]],"path":"apps/c