 error:\n\n<details>\n<summary>Suggested fix</summary>\n\n```diff\n-        if (cq === null) throw new Error('ENOENT');\n+        if (cq === null) throw Object.assign(new Error('ENOENT'), { code: 'ENOENT' });\n```\n\n</details>","id":"f2f5ad3d85f8007cd960f54a746a56c7200e833313810347ba278cacb7cbfee0","intervals":[[471,471]],"path":"test/ops/dev/denylist.test.ts","severity":"major","source_id":null,"status":"untriaged","title":"Attach the `ENOENT` errno code to the missing-config fixture."}],"head":"75ea6389daffad6f090f25711da3a2343b604d0f","head_tree":"51ba50b1b1dd4985afa637ff27d9e12676620073","input_scope":[{"blob":"a9f1bf6fd5584807c4ae4b37304e87c9dbd9f59e","intervals":[[1,401]],"path":"test/ops/dev/cycle-budget.test.ts"},{"blob":"cdc2e977d058a803f093904f55e8790afa5d2965","intervals":[[1,469]],"path":"test/ops/dev/cycle-green-prefix.helpers.ts"},{"blob":"840dc9302f3ac9c9498c30df4d3a5f34fe7648a2","intervals":[[1,242]],"path":"test/ops/dev/cycle-green-prefix.probe-scan.test.ts"},{"blob":"7b9b33f12f385f5edec910e6ef6d1e8a13cdafb1","intervals":[[1,173]],"path":"test/ops/dev/cycle-green-prefix.publication.test.ts"},{"blob":"12e8af6c8abd286ed41ea48c0a97512b5df476e2","intervals":[[1,365]],"path":"test/ops/dev/cycle-m7-usage.test.ts"},{"blob":"8ee63407475b9b23eee847bafb1376e561bf156c","intervals":[[1,542]],"path":"test/ops/dev/cycle-publication.test.ts"},{"blob":"445b3be31afe65bf3f69f3d020e7e7b0b195f9e4","intervals":[[1,598]],"path":"test/ops/dev/denylist.test.ts"},{"blob":"59a4eb59ccacc868da751341cf97b29d60619c74","intervals":[[1,173]],"path":"test/ops/dev/effects.test.ts"}],"job_id":"27414a0ae4bc99a97a09c6f2a04436aff79d37e6f60dd105f5c125cc71049dd5:0","outcome":"completed","paths":[{"baseline":{"method":"projection","reason":"path cluster"},"blob":"a9f1bf6fd5584807c4ae4b37304e87c9dbd9f59e","disposition":"included","mode":"100644","path":"test/ops/dev/cycle-budget.test.ts","reason":"bounded verified input"},{"baseline":{"method":"projection","reason":"path cluster"},"blob":"