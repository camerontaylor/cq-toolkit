c0057c686a27a842a33641b","intervals":[[157,157]],"path":"docs/0.2-release-runbook.md","severity":"minor","source_id":null,"status":"untriaged","title":"Make the candidate-ref fallback usable throughout the audit."},{"anchor_status":"verified","blob":"69c2411ecb2a203b1b0b049c132130014d4caacb","body":"**Preserve the supported GitHub token credential.**\n\nIf the operator authenticates only with `GITHUB_TOKEN`, `env -u GITHUB_TOKEN` removes the credential before dispatch. The install-matrix gate then fails, although `gh` supports that environment variable and the pack-audit block retains it. Preserve the token for both dispatch and polling. ([cli.github.com](https://cli.github.com//manual/gh_help_environment?utm_source=openai))","id":"fb5a187a3daa2de7ebe54d7c1b89ee5e74a1a75c7d722054a4f151cd89477fc8","intervals":[[134,134]],"path":"docs/0.2-release-runbook.md","severity":"minor","source_id":null,"status":"untriaged","title":"Preserve the supported GitHub token credential."}],"head":"c5e77c81b33feb87024d74577abdd2f066f12c55","head_tree":"f3d13794b479ccd72ccb765c7289aa9698c4c59f","input_scope":[{"blob":"69c2411ecb2a203b1b0b049c132130014d4caacb","intervals":[[14,15],[19,25],[60,60],[81,81],[99,108],[112,160],[202,204],[226,227]],"path":"docs/0.2-release-runbook.md"}],"job_id":"f14869359fd4c908f8ef46674ebba00162fa1017bf1aefb41fdff0cb5aa13fde:0","outcome":"completed","paths":[{"baseline":{"entry":{"blob":"47660464df092709fee93c34046e23a486c454ac","kind":"blob","mode":"100644","path":"docs/0.2-release-runbook.md"},"merge":"920e147b324cb85fc5b695243a96dfec1706ec86","method":"pre-merge","pre":"77a4c5b9c41892e82d6404383e262ae3281e7638","source_path":"docs/0.2-release-runbook.md"},"blob":"69c2411ecb2a203b1b0b049c132130014d4caacb","disposition":"included","mode":"100644","path":"docs/0.2-release-runbook.md","reason":"bounded verified input"}],"policy_digest":"eacd1bcf42a0e72eca72fcf9c1e9c8f97e7c515cd67a8fa7965c966924647693","repo":"camerontaylor/cq-toolkit","requested_scope":[{"bl