{"event_type":"review","id":"b00beb04251c5f8f5427f3fb17bcd51969d7a80273f30e78e70b390bd5a7ccde","occurred_at":"2026-11-17T08:26:47Z","payload":{"artifacts":[{"location":"/home/ctaylor/.local/share/crq-backfill/artifacts/sha256/fd343bb4c8fe36e9c156d723bb0b4576af4ab67c41a90d719fa36f4f0961074b","sha256":"fd343bb4c8fe36e9c156d723bb0b4576af4ab67c41a90d719fa36f4f0961074b"},{"location":"/home/ctaylor/.local/share/crq-backfill/artifacts/sha256/cbdbc5d60df9f3464fe88e96375aa508ab1873b69808dcdbe9aae19ce2482639","sha256":"cbdbc5d60df9f3464fe88e96375aa508ab1873b69808dcdbe9aae19ce2482639"},{"kind":"git-bundle","location":"/home/ctaylor/.local/share/crq-backfill/artifacts/sha256/24add0ec45ac2be9a4041aaba5874e36c1051b60286535b70b126e32f47faa2f","sha256":"24add0ec45ac2be9a4041aaba5874e36c1051b60286535b70b126e32f47faa2f"},{"location":"/home/ctaylor/.local/share/crq-backfill/artifacts/sha256/1a81eaf1304c9b9eb589e3a29bd7ca754837f2f0500501178cb494e1fe2aea27","sha256":"1a81eaf1304c9b9eb589e3a29bd7ca754837f2f0500501178cb494e1fe2aea27"},{"location":"/home/ctaylor/.local/share/crq-backfill/artifacts/sha256/996d669325055146195cd8235c20554148f2efbcd4241220fffb747364036587","sha256":"996d669325055146195cd8235c20554148f2efbcd4241220fffb747364036587"}],"attempt_id":"32015c96fd59f6e7e440356f102e27f262a1948a81cebd71d8cd9bf00d894475:0:1","base":"1760fe165133c08f5723b6622fa3413da5fb6e8d","completion":{"errors":[],"exit_code":0,"scope_verified":true,"skipped":false,"terminal":true},"findings":[{"anchor_status":"verified","blob":"21b1e9424249783dd25e9139e5899e0a7154eef5","body":"**Add `version: 1` to `terminalReport`.**\n\n`ReviewAddressReport` requires `version: 1`. The literal returned by `terminalReport` at `test/ops/review/addressManyWorktree.test.ts:2205` omits it. The return-type annotation on line 2204 therefore rejects the object, and `tsc` reports TS2741. The root `tsconfig.json` includes `test`, so this error can fail the repository typecheck that `check:static` runs. The fixture also differs from the writer, which always sets `version: 1`. `tsconfig.build.json` excludes tests, so the build output is not affected.\n\n<details>\n<summary>Suggested fix</summary>\n\n```diff\n function terminalReport(path: string): ReviewAddressReport {\n   return {\n+    version: 1,\n     source: 'local',\n     reportPath: path,\n```\n\n</details>","id":"4392830ee688e1cd403d691b807c4eec54fffc10949481951a412d9fa0d56bbf","intervals":[[2204,2206]],"path":"test/ops/review/addressManyWorktree.test.ts","severity":"major","source_id":null,"status":"untriaged","title":"Add `version: 1` to `terminalReport`."}],"head":"10e968089137fe954095885defcdd0e87c62285f","head_tree":"74119e2e60617e97b4070712a18195b8b48c1179","input_scope":[{"blob":"21b1e9424249783dd25e9139e5899e0a7154eef5","intervals":[[1,3307]],"path":"test/ops/review/addressManyWorktree.test.ts"}],"job_id":"32015c96fd59f6e7e440356f102e27f262a1948a81cebd71d8cd9bf00d894475:0","outcome":"completed","paths":[{"baseline":{"method":"projection","reason":"residual uncovered lines"},"blob":"21b1e9424249783dd25e9139e5899e0a7154eef5","disposition":"included","mode":"100644","path":"test/ops/review/addressManyWorktree.test.ts","reason":"bounded verified input"}],"policy_digest":"eacd1bcf42a0e72eca72fcf9c1e9c8f97e7c515cd67a8fa7965c966924647693","repo":"camerontaylor/cq-toolkit","requested_scope":[{"blob":"21b1e9424249783dd25e9139e5899e0a7154eef5","intervals":[[1,17],[24,32],[34,149],[190,190],[251,1994],[2204,3307]],"path":"test/ops/review/addressManyWorktree.test.ts"}],"reviewed_scope":[{"blob":"21b1e9424249783dd25e9139e5899e0a7154eef5","intervals":[[1,17],[24,32],[34,149],[190,190],[251,1994],[2204,3307]],"path":"test/ops/review/addressManyWorktree.test.ts"}],"scope_digest":"103e5ba8705339a2d72dbe222be52a2a41154c2d208a69743d2b5b5340faf333","source":{"authenticated":true,"id":"backfill-32015c96fd59f6e7e440356f102e27f262a1948a81cebd71d8cd9bf00d894475-g0-20261117T082437Z","producer":"crq-runner-app","repo":"camerontaylor/cq-toolkit","typ