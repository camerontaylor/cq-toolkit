f\n-for (const name of await readdir(artifactDir).catch(() => [])) {\n+for (const name of (await readdir(artifactDir).catch(() => [])).sort()) {\n```\n</details>","id":"a7dc3100247766ed97a4b7285b0c0f6fb833e4f9c9c16f00df35034b64cd06ef","intervals":[],"path":"scripts/adversarial-manifest.mjs","severity":"minor","source_id":null,"status":"untriaged","title":"Sort the artifact names before building `reports`."},{"anchor_status":"unverified","blob":"5dc9b11f06287e864c30b0d72773084614b7596f","body":"**Reject unresolved package import aliases.**\n\nIn `scripts/api-report.mjs:280`, a missing `imports` field makes `resolveImportAlias` return `undefined`. The declaration graph then skips the reference. If a declaration uses a `#` alias supplied by TypeScript `paths`, changes to its target can go undetected by the baseline comparison.\n\nAt line 313, targets beginning with `../` or `/` are also skipped, although Node rejects them. Keep external package mappings unchanged.\n\n<details>\n<summary>Proposed fix</summary>\n\n```diff\n-  if (!imports || typeof imports !== 'object') return undefined;\n+  if (!imports || typeof imports !== 'object' || Array.isArray(imports))\n+    throw new Error(`cannot resolve package import ${specifier}: no package.json#imports`);\n```\n\n```diff\n-  return mapped.startsWith('./') ? mapped : undefined;\n+  if (mapped.startsWith('./')) return mapped;\n+  if (mapped.startsWith('../') || mapped.startsWith('/'))\n+    throw new Error(`invalid package import target for ${specifier}: ${mapped}`);\n+  return undefined;\n```\n\n</details>","id":"e6c116cd5d158e676e1c1963f6252b94c7a08986caf63b72ca36ee4f9dddab57","intervals":[],"path":"scripts/api-report.mjs","severity":"minor","source_id":null,"status":"untriaged","title":"Reject unresolved package import aliases."}],"head":"e945b6b72148211f31600fd453f0c0eda411ffc6","head_tree":"013c2fa4bf520f2358e9d1367a3d73c21ab4fb44","input_scope":[{"blob":"fe980e404c9377e34f6c1575f671b28150655d77","intervals":[[1,251]],"