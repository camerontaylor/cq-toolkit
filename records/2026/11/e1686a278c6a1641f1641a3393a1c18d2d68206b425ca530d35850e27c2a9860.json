ops/dev/denylist.ts:617`). A relative `PATH` entry therefore resolves inside the clone during the scan. If the clone contains an executable at that relative location that exits 0 and writes a valid empty JSON report, the scan can return a clean verdict from a binary the probe never checked. This requires a relative entry in the runner's `PATH` and a repository-supplied executable at the matching path. Absolute `PATH` entries do not resolve against the clone.\n\nResolve the probed candidate to an absolute path. Run that exact path for the scan. Do not run the bare name `gitleaks` after the probe succeeds.","id":"17734d3c74144d2c8bcdaaf94ec5fcc16e0ba0aa3799e53b720a06c080c1b728","intervals":[[418,419]],"path":"src/adapters/crq/repairPreparation.ts","severity":"minor","source_id":null,"status":"untriaged","title":"Bind the availability probe and the gitleaks scan to the same executable."}],"head":"32872c64b5a09db9f745b4ff1e9b69148ab5f69c","head_tree":"7e3bc6040d8da1acb2564424b853efe795537180","input_scope":[{"blob":"822ea9a8caf075bc798fcb4b9faa7d68ffebe10b","intervals":[[1,640]],"path":"src/adapters/crq/repairPreparation.ts"},{"blob":"147a47a5019224144c5afd24a32ddf3be1f74dcb","intervals":[[1,495]],"path":"src/adapters/crq/summarySource.ts"}],"job_id":"9430299339b1d1ee58ec1ec336e1508f0683988b0deb64a617927412596e3f76:0","outcome":"completed","paths":[{"baseline":{"method":"projection","reason":"path cluster"},"blob":"822ea9a8caf075bc798fcb4b9faa7d68ffebe10b","disposition":"included","mode":"100644","path":"src/adapters/crq/repairPreparation.ts","reason":"bounded verified input"},{"baseline":{"method":"projection","reason":"path cluster"},"blob":"147a47a5019224144c5afd24a32ddf3be1f74dcb","disposition":"included","mode":"100644","path":"src/adapters/crq/summarySource.ts","reason":"bounded verified input"}],"policy_digest":"eacd1bcf42a0e72eca72fcf9c1e9c8f97e7c515cd67a8fa7965c966924647693","repo":"camerontaylor/cq-toolkit","requested_scope":[{"blob":"822ea9a8caf075bc798fcb4b9