top.org/basedir/?utm_source=openai))\n\n<details>\n<summary>Proposed change</summary>\n\n```diff\n-import { join } from 'node:path';\n+import { isAbsolute, join } from 'node:path';\n...\n-    stateHome !== undefined && stateHome.trim() !== ''\n+    stateHome !== undefined && stateHome.trim() !== '' && isAbsolute(stateHome)\n```\n</details>","id":"b65f22273e242143bc3aa7f78f7c54c93dc5c761f5c1a955621fac4481064ebe","intervals":[],"path":"src/driver/sessions-dir.ts","severity":"minor","source_id":null,"status":"untriaged","title":"Ignore a relative `XDGSTATEHOME`."}],"head":"bc6d3bbced26078d6782df870cbb136555dc4b10","head_tree":"067d49da10942551a3c39da201ad1d79467f9afa","input_scope":[{"blob":"12562c43560518d492e1a6df68b654201e266652","intervals":[[1,36]],"path":"src/driver/sessions-dir.ts"}],"job_id":"1d4a41b0352a507dc17cf6d3d0c70b1dc8e46d317a56f3586b3cd378faeeeda0:0","outcome":"completed","paths":[{"baseline":{"method":"projection","reason":"path cluster"},"blob":"12562c43560518d492e1a6df68b654201e266652","disposition":"included","mode":"100644","path":"src/driver/sessions-dir.ts","reason":"bounded verified input"}],"policy_digest":"eacd1bcf42a0e72eca72fcf9c1e9c8f97e7c515cd67a8fa7965c966924647693","repo":"camerontaylor/cq-toolkit","requested_scope":[{"blob":"12562c43560518d492e1a6df68b654201e266652","intervals":[[20,20],[26,26],[30,30]],"path":"src/driver/sessions-dir.ts"}],"reviewed_scope":[{"blob":"12562c43560518d492e1a6df68b654201e266652","intervals":[[20,20],[26,26],[30,30]],"path":"src/driver/sessions-dir.ts"}],"scope_digest":"148a726acd4c687218f04e638c14b23c527aabcf648c04770d373a2ed3e917ee","source":{"authenticated":true,"id":"backfill-1d4a41b0352a507dc17cf6d3d0c70b1dc8e46d317a56f3586b3cd378faeeeda0-g0-20261108T110359Z","producer":"crq-runner-app","repo":"camerontaylor/cq-toolkit","type":"crq-run"},"subject_id":"1d4a41b0352a507dc17cf6d3d0c70b1dc8e46d317a56f3586b3cd378faeeeda0","target":"9ba0d4661956d91e3c1bd4a95ee9369044eaa9f3","target_tree":"067d49da10942551a3c3