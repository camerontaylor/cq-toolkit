{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["cli_version", "format", "run_id", "head", "base", "attempt_id", "submitted_scope"],
  "properties": {
    "cli_version": {
      "type": "string",
      "minLength": 1
    },
    "format": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "head": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "base": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "submitted_scope": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "blob", "intervals"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "blob": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "intervals": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              },
              "minItems": 2,
              "maxItems": 2
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
