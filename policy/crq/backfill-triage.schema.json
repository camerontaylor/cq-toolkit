{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["review_id", "finding", "target", "canonical_id", "previous_event_id", "status"],
  "properties": {
    "review_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "finding": {
      "type": "object",
      "required": [
        "id",
        "severity",
        "path",
        "blob",
        "intervals",
        "title",
        "body",
        "status",
        "anchor_status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "severity": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": ["string", "null"]
        },
        "blob": {
          "type": ["string", "null"]
        },
        "intervals": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "minItems": 2,
            "maxItems": 2
          }
        },
        "title": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "source_id": {
          "type": ["string", "null"]
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "anchor_status": {
          "enum": ["verified", "unverified"]
        }
      },
      "additionalProperties": true
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "canonical_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "previous_event_id": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "target_current": {
      "type": ["string", "null"]
    },
    "mapped_path": {
      "type": ["string", "null"]
    },
    "mapped_intervals": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "integer",
          "minimum": 1
        },
        "minItems": 2,
        "maxItems": 2
      }
    },
    "recovered_anchor": {
      "type": ["object", "null"]
    },
    "receipt": {
      "type": ["object", "null"]
    }
  },
  "additionalProperties": true
}
