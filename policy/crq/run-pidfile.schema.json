{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["run_id", "pid", "ppid", "pgid", "sid", "group_owner"],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "pid": {
      "type": "integer",
      "minimum": 1
    },
    "ppid": {
      "type": "integer",
      "minimum": 1
    },
    "pgid": {
      "type": "integer",
      "minimum": 1
    },
    "sid": {
      "type": "integer",
      "minimum": 1
    },
    "group_owner": {
      "const": "foreground-v1"
    },
    "cli_pid": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": true
}
