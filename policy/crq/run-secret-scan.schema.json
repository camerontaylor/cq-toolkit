{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "base",
    "head",
    "denylist_rules",
    "denylist_hits",
    "gitleaks",
    "gitleaks_hits",
    "diff_bytes"
  ],
  "properties": {
    "base": {
      "type": ["string", "null"]
    },
    "head": {
      "type": ["string", "null"]
    },
    "denylist_rules": {
      "type": "integer",
      "minimum": 0
    },
    "denylist_hits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule", "file", "diff_line"],
        "properties": {
          "rule": {
            "type": "string",
            "minLength": 1
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "diff_line": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": true
      }
    },
    "gitleaks": {
      "type": "string"
    },
    "gitleaks_hits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule", "diff_line"],
        "properties": {
          "rule": {
            "type": ["string", "null"]
          },
          "diff_line": {
            "type": ["integer", "null"]
          }
        },
        "additionalProperties": true
      }
    },
    "diff_bytes": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": true
}
