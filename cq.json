{
  "schemaVersion": 2,
  "checks": [
    {
      "adapter": "tsc-lines",
      "kind": "static",
      "command": {
        "command": "node_modules/.bin/tsc",
        "args": ["--noEmit", "-p", "tsconfig.json", "--pretty", "false"],
        "cwd": "."
      },
      "relatedArgs": ["--noEmit", "-p", "tsconfig.json", "--pretty", "false"]
    },
    {
      "adapter": "vitest-json",
      "kind": "tests",
      "command": {
        "command": "node_modules/.bin/vitest",
        "args": ["run", "--reporter=json"],
        "cwd": "."
      },
      "relatedArgs": ["run", "--reporter=json", "{files}"]
    }
  ],
  "roles": {
    "worker": {
      "provider": "zai",
      "model": "glm-5.3-flash"
    },
    "rescue": {
      "provider": "opencode-go",
      "model": "deepseek-v4.1-flash"
    },
    "reviewer": {
      "provider": "opencode-go",
      "model": "deepseek-v4.1-flash"
    }
  },
  "review": {
    "reviewers": ["coderabbit", "agent"],
    "denylistPatternsFile": "policy/denylist/patterns.yml"
  }
}
